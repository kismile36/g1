function KismileLibrary:Notify(data)
    if not self.Notifications then return end
    data = data or {}

    local n = Instance.new("Frame")
    n.Name = data.Title or "Notification"
    n.Size = UDim2.new(0, 270, 0, 62)
    n.Position = UDim2.new(1.05, 0, 0, 0)
    n.BackgroundColor3 = SelectedTheme.NotificationBackground
    n.BorderSizePixel = 0
    n.AnchorPoint = Vector2.new(1, 0)
    n.Parent = self.Notifications
    addCorner(n, UDim.new(0, 8))
    addStroke(n, SelectedTheme.ElementStroke, 1.5, 0)

    local offset = 12
    if data.Image then
        local icon = Instance.new("ImageLabel")
        icon.Image = "rbxassetid://" .. tostring(data.Image)
        icon.BackgroundTransparency = 1
        icon.Size = UDim2.new(0, 22, 0, 22)
        icon.Position = UDim2.new(0, 12, 0, 14)
        icon.ImageColor3 = SelectedTheme.TextColor
        icon.Parent = n
        offset = 42
    end

    createText(n, data.Title or "Notification",
        Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
        13, SelectedTheme.TextColor,
        { Position = UDim2.new(0, offset, 0, 10), Size = UDim2.new(1, -offset - 12, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd }
    )

    createText(n, data.Content or "",
        Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
        11, SelectedTheme.TextColor,
        { Position = UDim2.new(0, offset, 0, 34), Size = UDim2.new(1, -offset - 12, 0, 16), TextTransparency = 0.3, TextTruncate = Enum.TextTruncate.AtEnd }
    )

    -- Slide in
    xtween(n, { Position = UDim2.new(1, -10, 0, 0) }, 0.3)

    -- Auto remove
    local dur = data.Duration or 5
    task.delay(dur, function()
        if n and n.Parent then
            xtween(n, { Position = UDim2.new(1.05, 0, 0, 0) }, 0.3)
            task.delay(0.35, function()
                if n then n:Destroy() end
            end)
        end
    end)

    return n
end

