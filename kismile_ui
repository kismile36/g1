local function packColor(color)
    return { R = math.floor(color.R * 255 + 0.5), G = math.floor(color.G * 255 + 0.5), B = math.floor(color.B * 255 + 0.5) }
end

local function unpackColor(tbl)
    return Color3.fromRGB(tbl.R, tbl.G, tbl.B)
end

local function isCustomAsset(val)
    return type(val) == "string" and (val:find("rbxasset://") == 1 or val:find("rbxthumb://") == 1)
end

-- Create a text label helper
local function createText(parent, text, font, size, color, extra)
    local lbl = Instance.new("TextLabel")
    lbl.Text = text or ""
    lbl.FontFace = font or Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)
    lbl.TextSize = size or 13
    lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Center
    if extra then for k, v in pairs(extra) do pcall(function() lbl[k] = v end) end end
    lbl.Parent = parent
    return lbl
end

