                    Position = UDim2.new(0, 12, 0, 6),
                    ZIndex = 6,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }
            )

            -- Selected value display
            local function GetSelectedText()
                if MultiSelect then
                    return #Value > 0 and (#Value .. " selected") or "None"
                else
                    return tostring(Value or "None")
                end
            end

            local SelectedLabel = UIUtil:CreateText(Element, GetSelectedText(),
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                11, Kismile.CurrentTheme.Accent,
                {
                    Size = UDim2.new(0.5, -24, 0, 16),
                    Position = UDim2.new(0, 12, 0, 28),
                    ZIndex = 6,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }
            )

            -- Arrow
            local Arrow = UIUtil:CreateText(Element, "v",
