local RayfieldFolder = "Kismile"
local ConfigurationFolder = RayfieldFolder .. "/Configurations"
local ConfigurationExtension = ".kcf"

-- Rayfield-style settings table
local settingsTable = {
    General = {
        kismileOpen = { Type = "bind", Value = "RightShift", Name = "Kismile Keybind" },
    },
    System = {
        -- Reserved for future use
    },
}

local overriddenSettings = {}

local function overrideSetting(category, name, value)
    overriddenSettings[category .. "." .. name] = value
end

local function getSetting(category, name)
    if overriddenSettings[category .. "." .. name] ~= nil then
        return overriddenSettings[category .. "." .. name]
    elseif settingsTable[category] and settingsTable[category][name] ~= nil then
        return settingsTable[category][name].Value
    end
end

local function loadSettings()
    local file = nil
    local ok = pcall(function()
        if callSafely(isfolder, RayfieldFolder) then
            if callSafely(isfile, RayfieldFolder .. "/settings" .. ConfigurationExtension) then
                file = callSafely(readfile, RayfieldFolder .. "/settings" .. ConfigurationExtension)
            end
        end
        if file then
            local decoded = HttpService:JSONDecode(file)
            if decoded then
                for catName, catTbl in pairs(decoded) do
                    for settingName, setting in pairs(catTbl) do
                        local default = settingsTable[catName] and settingsTable[catName][settingName]
                        if default and type(default.Value) == type(setting.Value) then
                            default.Value = setting.Value
                        end
                    end
                end
            end
        end
    end)
end

loadSettings()

function KismileLibrary:LoadConfiguration(configData)
    if not configData or #configData == 0 then return false end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(configData) end)
    if not ok then return false end
    for flag, value in pairs(decoded) do
        self.Flags[flag] = value
    end
    return true
end

function KismileLibrary:SaveConfiguration()
    if not writefile then return false end
    ensureFolder(ConfigurationFolder)
    local path = ConfigurationFolder .. "/" .. (self.ConfigFileName or "config") .. ConfigurationExtension
    local json = HttpService:JSONEncode(self.Flags)
    callSafely(writefile, path, json)
    return true
end

function KismileLibrary:LoadConfigFromFile(fileName)
    if not isfile or not readfile then return false end
    local path = ConfigurationFolder .. "/" .. (fileName or self.ConfigFileName or "config") .. ConfigurationExtension
    if not isfile(path) then return false end
    local content = readfile(path)
    if not content or #content == 0 then return false end
    return self:LoadConfiguration(content)
end

-- Set element value programmatically (replaces elem:Set(value) pattern)
function KismileLibrary:SetElement(elem, ...)
    local fn = ElementSetters[elem]
    if fn then fn(...) end
end

