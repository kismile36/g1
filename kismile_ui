        -- TOGGLE
        function Tab:CreateToggle(ToggleSettings)
            local Value = ToggleSettings.CurrentValue or false
            if ToggleSettings.Flag and KismileLibrary.Flags[ToggleSettings.Flag] ~= nil then
                Value = KismileLibrary.Flags[ToggleSettings.Flag]
            end

            local elem = Instance.new("Frame")
            elem.Name = ToggleSettings.Name or "Toggle"
            elem.Size = UDim2.new(1, 0, 0, 42)
            elem.BackgroundColor3 = SelectedTheme.ElementBackground
            elem.BorderSizePixel = 0
