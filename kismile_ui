                13, SelectedTheme.TextColor,
                { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.5, -44, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 }
            )

            local prev = Instance.new("Frame")
