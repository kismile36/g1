                Parent = self.Scroll,
            })
            UIUtil:AddCorner(Element, UDim.new(0, 8))
            UIUtil:AddStroke(Element, Kismile.CurrentTheme.ElementBorder, 1, 0.5)

            -- Title
            UIUtil:CreateText(Element, SliderSettings.Title or "Slider",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                13, Kismile.CurrentTheme.TextColor,
                {
                    Size = UDim2.new(0.5, -24, 0, 20),
                    Position = UDim2.new(0, 12, 0, 6),
                    ZIndex = 6,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }
            )

            -- Value display
            local ValueLabel = UIUtil:CreateText(Element, tostring(Value) .. (SliderSettings.Suffix or ""),
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                12, Kismile.CurrentTheme.Accent,
                {
                    Size = UDim2.new(0.5, -24, 0, 20),
                    Position = UDim2.new(0.5, 12, 0, 6),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 6,
                }
            )

            -- Slider track
            local SliderTrack = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -24, 0, 6),
                Position = UDim2.new(0, 12, 0.5, 6),
                BackgroundColor3 = Kismile.CurrentTheme.SliderBackground,
                BorderSizePixel = 0,
                ZIndex = 6,
                Parent = Element,
            })
            UIUtil:AddCorner(SliderTrack, UDim.new(0, 3))

            -- Slider fill
            local Percent = (Value - Min) / (Max - Min)
            local SliderFill = UIUtil:Create("Frame", {
                Size = UDim2.new(Percent, 0, 1, 0),
                BackgroundColor3 = Kismile.CurrentTheme.SliderFill,
                BorderSizePixel = 0,
                ZIndex = 7,
                Parent = SliderTrack,
            })
            UIUtil:AddCorner(SliderFill, UDim.new(0, 3))

            -- Slider handle
            local SliderHandle = UIUtil:Create("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(Percent, -7, 0.5, -7),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                ZIndex = 8,
                Parent = SliderTrack,
            })
            UIUtil:AddCorner(SliderHandle, UDim.new(1, 0))

            -- Drag detection
            local IsDragging = false

            local function UpdateSliderFromPosition(PositionX)
                local TrackAbsX = SliderTrack.AbsolutePosition.X
                local TrackAbsSize = SliderTrack.AbsoluteSize.X
                local Relative = math.clamp((PositionX - TrackAbsX) / TrackAbsSize, 0, 1)
                local RawValue = Min + Relative * (Max - Min)

                if Step then
                    Value = Min + math.floor((RawValue - Min) / Step + 0.5) * Step
                    Value = math.clamp(Value, Min, Max)
                else
                    Value = math.floor(RawValue * 100) / 100
                end

                Percent = (Value - Min) / (Max - Min)

                Animation:Spring(SliderFill, { Size = UDim2.new(Percent, 0, 1, 0) }, 0.05)
                Animation:Spring(SliderHandle, { Position = UDim2.new(Percent, -7, 0.5, -7) }, 0.05)

                ValueLabel.Text = tostring(Value) .. (SliderSettings.Suffix or "")

                if SliderSettings.Flag then
                    Kismile:SetFlag(SliderSettings.Flag, Value)
                end
                if SliderSettings.Callback then
                    SliderSettings.Callback(Value)
                end
            end

            SliderTrack.InputBegan:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    IsDragging = true
                    UpdateSliderFromPosition(Input.Position.X)
                end
            end)

            SliderHandle.InputBegan:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    IsDragging = true
                end
            end)

            local DragConnection = Services.UserInputService.InputEnded:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    IsDragging = false
                end
            end)
            table.insert(Kismile.Connections, DragConnection)

            local MoveConnection = Services.UserInputService.InputChanged:Connect(function(Input)
                if IsDragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSliderFromPosition(Input.Position.X)
                end
            end)
            table.insert(Kismile.Connections, MoveConnection)

            -- Element functions
            Element.SetValue = function(self, NewValue)
                Value = math.clamp(NewValue, Min, Max)
                if Step then
                    Value = Min + math.floor((Value - Min) / Step + 0.5) * Step
                end
                Percent = (Value - Min) / (Max - Min)
                SliderFill.Size = UDim2.new(Percent, 0, 1, 0)
                SliderHandle.Position = UDim2.new(Percent, -7, 0.5, -7)
                ValueLabel.Text = tostring(Value) .. (SliderSettings.Suffix or "")
            end
            Element.GetValue = function()
                return Value
            end

            table.insert(self.Elements, Element)
            return Element
        end

        -- Dropdown (single & multi-select)
        function Tab:CreateDropdown(DropdownSettings)
            DropdownSettings = DropdownSettings or {}

            local Options = DropdownSettings.Options or {}
            local DefaultValue = DropdownSettings.MultiSelect and (DropdownSettings.Default or {}) or (DropdownSettings.Default or Options[1])
            local MultiSelect = DropdownSettings.MultiSelect or false

            local Value = DefaultValue
            if DropdownSettings.Flag and Kismile.Flags[DropdownSettings.Flag] ~= nil then
                Value = Kismile.Flags[DropdownSettings.Flag]
            end

            local IsOpen = false

            local Element = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -20, 0, 50),
                BackgroundColor3 = Kismile.CurrentTheme.ElementBackground,
                BorderSizePixel = 0,
