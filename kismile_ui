            prev.ZIndex = 6
            prev.Parent = elem
            addCorner(prev, UDim.new(0, 4))
            addStroke(prev, Color3.fromRGB(255, 255, 255), 1, 0.5)

            -- Panel
            local panel = Instance.new("Frame")
            panel.Size = UDim2.new(1, -4, 0, 0)
            panel.Position = UDim2.new(0, 2, 1, -4)
            panel.BackgroundColor3 = SelectedTheme.ElementBackground
