local function getShapeMeta(shapeType)
    local resolved = ShapeAliases[shapeType] or shapeType
    return Shapes[resolved] or Shapes.Squircle
end

-- Creates a shape-based frame (Wind UI style)
local function createShape(parent, shapeType, radius, isButton, props)
    local classType = isButton and "ImageButton" or "ImageLabel"
    local meta = getShapeMeta(shapeType)

    local frame = Instance.new(classType)
    frame.Image = ""
    frame.ScaleType = Enum.ScaleType.Slice
    frame.SliceCenter = Rect.new(512, 512, 512, 512)
    frame.SliceScale = 1
    frame.BackgroundTransparency = 1

    if props then
        for k, v in pairs(props) do
            if k ~= "ThemeTag" then
                pcall(function() frame[k] = v end)
            end
        end
    end

    frame.Parent = parent

    -- Set shape
    local currentShape = meta
    frame.Image = currentShape.Image
    frame.SliceCenter = currentShape.Rect
    if radius and radius > 0 then
        frame.SliceScale = math.max(radius / currentShape.Radius, 0.0001)
    end

    -- Auto-adapt shape based on size (Wind UI feature)
    if meta.AutoChange ~= false then
        frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if meta.AutoChange == false then return end
            local w = frame.AbsoluteSize.X
            local h = frame.AbsoluteSize.Y
            local baseRadius = radius or math.min(w, h) / 2
            local ratio = baseRadius / math.min(w, h)

            local threshold = currentShape.Radius / 1024
            local newShape

            if w > h then
                newShape = ratio >= threshold and "SquircleH" or "Squircle"
            elseif w < h then
                newShape = ratio >= threshold and "SquircleV" or "Squircle"
            else
                newShape = ratio >= threshold and "Circle" or "Squircle"
            end

            -- Check if we need glass/outline variant
            if string.find(frame.Name, "Glass") or string.find(shapeType, "Glass") then
                newShape = newShape .. "Glass"
            elseif string.find(frame.Name, "Outline") or string.find(shapeType, "Outline") then
                newShape = newShape .. "Outline"
            end

            if newShape ~= shapeType and Shapes[newShape] then
                shapeType = newShape
                currentShape = getShapeMeta(newShape)
                frame.Image = currentShape.Image
                frame.SliceCenter = currentShape.Rect
                frame.SliceScale = math.max(baseRadius / currentShape.Radius, 0.0001)
            end

            frame.SliceScale = math.max(baseRadius / currentShape.Radius, 0.0001)
        end)
    end

    return frame
end

-- Simple fallback for when asset IDs fail
local function createSimpleFrame(parent, props)
    local f = Instance.new("Frame")
    for k, v in pairs(props or {}) do
        pcall(function() f[k] = v end)
    end
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
end

-- Add UICorner
local function addCorner(inst, radius)
    local c = inst:FindFirstChild("UICorner")
    if c then return c end
    return Instance.new("UICorner", inst)
end

-- Add UIStroke
local function addStroke(inst, color, thickness, transparency)
    local s = inst:FindFirstChild("UIStroke")
    if s then return s end
    s = Instance.new("UIStroke", inst)
    if color then s.Color = color end
    if thickness then s.Thickness = thickness end
    if transparency then s.Transparency = transparency end
    return s
end

