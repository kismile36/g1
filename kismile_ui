            createText(elem, ToggleSettings.Name or "Toggle",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                13, SelectedTheme.TextColor,
                { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.55, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 }
            )

            local toggleBody = Instance.new("Frame")
            toggleBody.Size = UDim2.new(0, 44, 0, 24)
            toggleBody.Position = UDim2.new(1, -54, 0.5, -12)
            toggleBody.BackgroundColor3 = Value and SelectedTheme.ToggleEnabled or SelectedTheme.ToggleBackground
            toggleBody.BorderSizePixel = 0
            toggleBody.ZIndex = 6
            toggleBody.Parent = elem
            addCorner(toggleBody, UDim.new(1, 0))
            addStroke(toggleBody, Value and SelectedTheme.ToggleEnabledStroke or SelectedTheme.ToggleDisabledStroke, 1, 0)

            local toggleDot = Instance.new("Frame")
            toggleDot.Size = UDim2.new(0, 16, 0, 16)
            toggleDot.Position = Value and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 4, 0.5, -8)
            toggleDot.BackgroundColor3 = Value and Color3.fromRGB(255, 255, 255) or SelectedTheme.ToggleDisabledStroke
            toggleDot.BorderSizePixel = 0
            toggleDot.ZIndex = 7
            toggleDot.Parent = toggleBody
            addCorner(toggleDot, UDim.new(1, 0))

            local function setToggle(val)
                Value = val
                xtween(toggleBody, { BackgroundColor3 = val and SelectedTheme.ToggleEnabled or SelectedTheme.ToggleBackground }, 0.15)
                if toggleBody:FindFirstChild("UIStroke") then
                    xtween(toggleBody.UIStroke, { Color = val and SelectedTheme.ToggleEnabledStroke or SelectedTheme.ToggleDisabledStroke }, 0.15)
                end
                xtween(toggleDot, {
                    Position = val and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 4, 0.5, -8),
                    BackgroundColor3 = val and Color3.fromRGB(255, 255, 255) or SelectedTheme.ToggleDisabledStroke,
                }, 0.15)

                if ToggleSettings.Flag then
                    KismileLibrary.Flags[ToggleSettings.Flag] = val
                end
                if ToggleSettings.Callback then
                    ToggleSettings.Callback(val)
                end
            end

            elem.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    setToggle(not Value)
                end
            end)

            bindElement(elem, setToggle)

            table.insert(Tab.Elements, elem)
            return elem
        end

        -- SLIDER
        function Tab:CreateSlider(SliderSettings)
            local Min = SliderSettings.Range[1] or 0
            local Max = SliderSettings.Range[2] or 100
            local Value = SliderSettings.CurrentValue or Min
            local Incr = SliderSettings.Increment or 1
            if SliderSettings.Flag and KismileLibrary.Flags[SliderSettings.Flag] ~= nil then
                Value = KismileLibrary.Flags[SliderSettings.Flag]
            end

            local elem = Instance.new("Frame")
            elem.Name = SliderSettings.Name or "Slider"
            elem.Size = UDim2.new(1, 0, 0, 48)
            elem.BackgroundColor3 = SelectedTheme.ElementBackground
            elem.BorderSizePixel = 0
            elem.ZIndex = 5
            elem.LayoutOrder = #Tab.Elements + 1
            elem.Parent = Tab.Page
            addCorner(elem, UDim.new(0, 6))
            addStroke(elem, SelectedTheme.ElementStroke, 1.5, 0)

            createText(elem, SliderSettings.Name or "Slider",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                13, SelectedTheme.TextColor,
                { Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(0.5, -10, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 }
            )

            local valLabel = createText(elem, tostring(Value) .. (SliderSettings.Suffix or ""),
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                11, SelectedTheme.Accent or SelectedTheme.SliderProgress,
                { Position = UDim2.new(0.5, 0, 0, 7), Size = UDim2.new(0.5, -10, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6 }
            )

            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, -20, 0, 8)
            bar.Position = UDim2.new(0, 10, 0.5, 4)
            bar.BackgroundColor3 = SelectedTheme.ToggleBackground
            bar.BorderSizePixel = 0
            bar.ZIndex = 6
            bar.Parent = elem
            addCorner(bar, UDim.new(0, 4))
            if SelectedTheme.SliderStroke then
                addStroke(bar, SelectedTheme.SliderStroke, 1, 0)
            end

            local perc = (Value - Min) / (Max - Min)
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(perc, 0, 1, 0)
            fill.BackgroundColor3 = SelectedTheme.SliderProgress
            fill.BorderSizePixel = 0
            fill.ZIndex = 7
            fill.Parent = bar
            addCorner(fill, UDim.new(0, 4))

            local handle = Instance.new("Frame")
            handle.Size = UDim2.new(0, 14, 0, 14)
            handle.Position = UDim2.new(perc, -7, 0.5, -7)
            handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            handle.BorderSizePixel = 0
            handle.ZIndex = 8
            handle.Parent = bar
            addCorner(handle, UDim.new(1, 0))

            local isDrag = false
            local function setSlider(v)
                Value = math.clamp(v, Min, Max)
                local p = (Value - Min) / (Max - Min)
                fill.Size = UDim2.new(p, 0, 1, 0)
                handle.Position = UDim2.new(p, -7, 0.5, -7)
                valLabel.Text = tostring(Value) .. (SliderSettings.Suffix or "")
                if SliderSettings.Flag then
                    KismileLibrary.Flags[SliderSettings.Flag] = Value
                end
                if SliderSettings.Callback then
                    SliderSettings.Callback(Value)
                end
            end

            local function fromMouse(mx)
                local r = math.clamp((mx - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local raw = Min + r * (Max - Min)
                raw = Min + math.floor((raw - Min) / Incr + 0.5) * Incr
                setSlider(raw)
            end

            bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    isDrag = true; fromMouse(i.Position.X)
                end
            end)
            local mv = UserInputService.InputChanged:Connect(function(i)
                if isDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
                    fromMouse(i.Position.X)
                end
            end)
            local ed = UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then isDrag = false end
            end)
            elem.Destroying:Connect(function() mv:Disconnect(); ed:Disconnect() end)

            bindElement(elem, setSlider)
            table.insert(Tab.Elements, elem)
            return elem
        end

