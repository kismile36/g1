        -- Keybind
        function Tab:CreateKeybind(KeybindSettings)
            KeybindSettings = KeybindSettings or {}
            local Value = KeybindSettings.Default or Enum.KeyCode.E
            local HoldMode = KeybindSettings.HoldMode or false
            local IsBinding = false

            if KeybindSettings.Flag and Kismile.Flags[KeybindSettings.Flag] ~= nil then
                local Saved = Kismile.Flags[KeybindSettings.Flag]
                if typeof(Saved) == "EnumItem" then Value = Saved
                elseif type(Saved) == "string" and Enum.KeyCode[Saved] then Value = Enum.KeyCode[Saved] end
            end

            local function GetKeyName()
                return Value and Value.Name:gsub("Keyboard", ""):gsub("Keypad", "Numpad ") or "None"
            end

            local Element = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -20, 0, 50),
                BackgroundColor3 = Kismile.CurrentTheme.ElementBackground,
                BorderSizePixel = 0,
                ZIndex = 5,
                LayoutOrder = #self.Elements + 1,
                Parent = self.Scroll,
            })
            UIUtil:AddCorner(Element, UDim.new(0, 8))
            UIUtil:AddStroke(Element, Kismile.CurrentTheme.ElementBorder, 1, 0.5)

            UIUtil:CreateText(Element, KeybindSettings.Title or "Keybind",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                13, Kismile.CurrentTheme.TextColor,
                {
                    Size = UDim2.new(0.5, -24, 0, 20),
                    Position = UDim2.new(0, 12, 0, 6),
                    ZIndex = 6,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }
            )

            local KeyButton = UIUtil:Create("TextButton", {
                Size = UDim2.new(0, 80, 0, 28),
                Position = UDim2.new(1, -92, 0.5, -14),
                BackgroundColor3 = Kismile.CurrentTheme.ElementBackground,
                Text = GetKeyName(),
                FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                TextSize = 12,
                TextColor3 = Kismile.CurrentTheme.Accent,
                ZIndex = 6,
                Parent = Element,
            })
            UIUtil:AddCorner(KeyButton, UDim.new(0, 6))
            UIUtil:AddStroke(KeyButton, Kismile.CurrentTheme.Accent, 1, 0.5)

            if KeybindSettings.Description then
                UIUtil:CreateText(Element, KeybindSettings.Description,
                    Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                    11, Kismile.CurrentTheme.TextSecondary,
                    {
                        Size = UDim2.new(0.5, -120, 0, 16),
                        Position = UDim2.new(0, 12, 0, 28),
                        ZIndex = 6,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    }
                )
            end

            local BindConn
            KeyButton.MouseButton1Click:Connect(function()
                if IsBinding then return end
                IsBinding = true
                KeyButton.Text = "..."

                if BindConn then BindConn:Disconnect() end
                BindConn = Services.UserInputService.InputBegan:Connect(function(Input)
                    if not IsBinding then return end
                    if Input.UserInputType ~= Enum.UserInputType.Keyboard then return end

                    if Input.KeyCode == Enum.KeyCode.Escape then
                        IsBinding = false; KeyButton.Text = GetKeyName()
                    elseif Input.KeyCode == Enum.KeyCode.Backspace then
                        Value = nil; IsBinding = false; KeyButton.Text = "None"
                    else
                        Value = Input.KeyCode; IsBinding = false; KeyButton.Text = GetKeyName()
                    end

                    if KeybindSettings.Flag then
                        Kismile:SetFlag(KeybindSettings.Flag, Value and Value.Name or nil)
                    end
                    if KeybindSettings.ChangedCallback then
                        KeybindSettings.ChangedCallback(GetKeyName())
                    end

                    if not IsBinding and BindConn then BindConn:Disconnect(); BindConn = nil end
                end)
            end)

            local PressConn = Services.UserInputService.InputBegan:Connect(function(Input)
                if IsBinding or not Value then return end
                if Input.KeyCode ~= Value then return end

                if HoldMode then
                    if KeybindSettings.Callback then KeybindSettings.Callback(true) end
                    local RelConn
                    RelConn = Services.UserInputService.InputEnded:Connect(function(RI)
                        if RI.KeyCode == Value then
                            if KeybindSettings.Callback then KeybindSettings.Callback(false) end
                            RelConn:Disconnect()
                        end
                    end)
                else
                    if KeybindSettings.Callback then KeybindSettings.Callback() end
                end
            end)
            table.insert(Kismile.Connections, PressConn)

            Element.SetValue = function(self, NK)
                if NK == nil then Value = nil
                elseif typeof(NK) == "EnumItem" then Value = NK end
                KeyButton.Text = GetKeyName()
            end
            Element.GetValue = function() return Value end

            table.insert(self.Elements, Element)
            return Element
        end

