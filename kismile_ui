-- Set current theme
function Kismile:SetTheme(Theme)
    if type(Theme) == "string" then
        self.CurrentTheme = Themes[Theme] or Themes.Default
    elseif type(Theme) == "table" then
        -- Merge with default for missing values
        self.CurrentTheme = {}
        for K, V in pairs(Themes.Default) do
            self.CurrentTheme[K] = Theme[K] or V
        end
    end

    if self.ScreenGui then
        UIUtil:ApplyTheme(self.ScreenGui, self.CurrentTheme)
    end

    return self.CurrentTheme
end

-- Get available theme names
function Kismile:GetThemes()
    local Names = {}
    for Name, _ in pairs(Themes) do
        table.insert(Names, Name)
    end
    table.sort(Names)
    return Names
end

-- Notification system
function Kismile:Notify(Settings)
    Settings = Settings or {}
    local Notification = {
        Title = Settings.Title or "Notification",
        Content = Settings.Content or "",
        Duration = Settings.Duration or 5,
        Type = Settings.Type or "default", -- default, success, warning, error, info
    }

    if not self.ScreenGui then return nil end

    local NotifHolder = self.ScreenGui:FindFirstChild("Notifications")
    if not NotifHolder then
        NotifHolder = UIUtil:Create("Frame", {
            Name = "Notifications",
            Size = UDim2.new(0, 300, 1, -60),
            Position = UDim2.new(1, -315, 0, 10),
            BackgroundTransparency = 1,
            ZIndex = 100,
            Parent = self.ScreenGui,
        })
        local NotifList = UIUtil:Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Top,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = NotifHolder,
        })
    end

    self.NotificationIndex = self.NotificationIndex + 1

    -- Notification frame
    local TypeColors = {
        default = self.CurrentTheme.Accent,
        success = Color3.fromRGB(50, 210, 100),
        warning = Color3.fromRGB(255, 180, 40),
        error = Color3.fromRGB(255, 70, 80),
        info = Color3.fromRGB(60, 160, 255),
    }

    local AccentColor = TypeColors[Notification.Type] or TypeColors.default

    local Frame = UIUtil:Create("Frame", {
        Size = UDim2.new(1, -10, 0, 70),
        BackgroundColor3 = self.CurrentTheme.NotificationBackground,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 100,
        Parent = NotifHolder,
    })

    UIUtil:AddCorner(Frame, UDim.new(0, 8))
    UIUtil:AddStroke(Frame, self.CurrentTheme.NotificationBorder, 1, 0.7)

    -- Accent bar on the left
    local AccentBar = UIUtil:Create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = AccentColor,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = Frame,
    })

    -- Icon
    local IconLabel = UIUtil:Create("TextLabel", {
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(0, 16, 0.5, -14),
        Text = ({
            default = "i",
            success = "?",
            warning = "!",
            error = "x",
            info = "i",
        })[Notification.Type] or "i",
        TextColor3 = AccentColor,
        FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
        TextSize = 16,
        BackgroundTransparency = 1,
        ZIndex = 101,
        Parent = Frame,
    })

    -- Title
    UIUtil:CreateText(Frame, Notification.Title,
        Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
        14, self.CurrentTheme.TextColor,
        {
            Size = UDim2.new(1, -60, 0, 20),
            Position = UDim2.new(0, 54, 0, 12),
            ZIndex = 101,
        }
    )

    -- Content
    UIUtil:CreateText(Frame, Notification.Content,
        Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
        12, self.CurrentTheme.TextSecondary,
        {
            Size = UDim2.new(1, -60, 0, 20),
            Position = UDim2.new(0, 54, 0, 34),
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 101,
        }
    )

    -- Duration bar
    local DurationBar = UIUtil:Create("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = AccentColor,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = Frame,
    })

    -- Entry animation
    Frame.Position = UDim2.new(1.5, 0, 0, 0)
    local EntryConnection
    EntryConnection = Services.RunService.RenderStepped:Connect(function()
        local CurrentX = Frame.Position.X.Scale
        local NewX = CurrentX + (1 - CurrentX) * 0.2
        if math.abs(NewX - 1) < 0.001 then
            Frame.Position = UDim2.new(1, -10, 0, 0)
            EntryConnection:Disconnect()
        else
            Frame.Position = UDim2.new(NewX, -10, 0, 0)
        end
    end)

    -- Duration countdown
    local StartTime = tick()
    local DurationConnection
    DurationConnection = Services.RunService.RenderStepped:Connect(function()
        local Elapsed = tick() - StartTime
        local Remaining = math.max(0, 1 - Elapsed / Notification.Duration)
        DurationBar.Size = UDim2.new(Remaining, 0, 0, 3)

        if Remaining <= 0 then
            DurationConnection:Disconnect()

            -- Exit animation
            local ExitTime = tick()
            local ExitConnection
            ExitConnection = Services.RunService.RenderStepped:Connect(function()
                local ExitElapsed = tick() - ExitTime
                local ExitAlpha = math.min(ExitElapsed / 0.3, 1)
                Frame.Position = UDim2.new(1 + ExitAlpha * 1.5, -10, 0, 0)
                Frame.BackgroundTransparency = ExitAlpha
                AccentBar.BackgroundTransparency = ExitAlpha
                IconLabel.TextTransparency = ExitAlpha
                DurationBar.BackgroundTransparency = ExitAlpha

                if ExitAlpha >= 1 then
                    ExitConnection:Disconnect()
                    Frame:Destroy()
                end
            end)

            -- Clean up text labels
            for _, Child in ipairs(Frame:GetChildren()) do
                if Child:IsA("TextLabel") and Child ~= IconLabel then
                    local TextChild = Child
                    task.spawn(function()
                        while TextChild and TextChild.Parent do
                            TextChild.TextTransparency = TextChild.TextTransparency + 0.1
                            if TextChild.TextTransparency >= 1 then break end
                            task.wait(0.03)
                        end
                    end)
                end
            end
        end
    end)

    return Frame
end

