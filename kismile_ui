-- Hidden UI
local function getHiddenUI()
    if gethui then return gethui()
    elseif syn and syn.protect_gui then
        local g = Instance.new("ScreenGui"); syn.protect_gui(g); return g
    elseif get_hidden_gui then return get_hidden_gui()
    elseif get_gui then return get_gui()
    else return CoreGui end
end

-- Get HWID
local function getHWID()
    if gethwid then return gethwid() end
    if syn and syn.crypt and syn.crypt.custom then
        local ok, r = pcall(function() return syn.crypt.custom.hash(LocalPlayer.UserId) end)
        if ok then return r end
    end
    return tostring(LocalPlayer.UserId)
end

-- Safe call wrapper
local function callSafely(fn, ...)
    if fn then
        local ok, result = pcall(fn, ...)
        if not ok then warn("Kismile | Error:", result); return false, result end
        return true, result
    end
    return false, "fn is nil"
end

local function ensureFolder(path)
    if isfolder and not callSafely(isfolder, path) then
        callSafely(makefolder, path)
    end
end

-- HTTP Get wrapper
local function requestGet(url)
    if syn and syn.request then
        local r = syn.request({ Url = url, Method = "GET" })
        return r.Body
    elseif request then
        local r = request({ Url = url, Method = "GET" })
        return r.Body
    elseif http_request then
        return http_request({ Url = url, Method = "GET" }).Body
    else
        return game:HttpGet(url)
    end
end

