-- Default theme
local SelectedTheme = KismileLibrary.Theme.Default

local function ChangeTheme(Theme)
    if type(Theme) == "string" then
        SelectedTheme = KismileLibrary.Theme[Theme] or KismileLibrary.Theme.Default
    elseif type(Theme) == "table" then
        -- Merge with Default for any missing tokens
        local merged = {}
        for k, v in pairs(KismileLibrary.Theme.Default) do merged[k] = v end
        for k, v in pairs(Theme) do merged[k] = v end
        SelectedTheme = merged
    end
end

