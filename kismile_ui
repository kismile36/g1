    -- ============================================================
    -- MODIFY THEME
    -- ============================================================
    function Window:ModifyTheme(Theme)
        ChangeTheme(Theme)

        -- Update main frame
        if Main then Main.ImageColor3 = SelectedTheme.Background end
        if Shadow then Shadow.ImageColor3 = SelectedTheme.Shadow end
        if Topbar then Topbar.BackgroundColor3 = SelectedTheme.Topbar end
        if TopbarCorner then TopbarCorner.BackgroundColor3 = SelectedTheme.Topbar end
        TitleLabel.TextColor3 = SelectedTheme.TextColor

        -- Update all text colors
        for _, obj in ipairs(KismileGui:GetDescendants()) do
            if obj.Parent and obj.Parent.Parent ~= Notifications then
                if obj:IsA("TextLabel") or obj:IsA("TextBox") then
                    if obj ~= TitleLabel then
                        obj.TextColor3 = SelectedTheme.TextColor
                    end
                end
            end
        end

        -- Update elements
        for _, page in ipairs(Elements:GetChildren()) do
            if page:IsA("ScrollingFrame") then
                for _, el in ipairs(page:GetChildren()) do
                    if el:IsA("Frame") and el.Name ~= "SectionTitle" and el.Name ~= "Divider" and el.Name ~= "Placeholder" then
                        el.BackgroundColor3 = SelectedTheme.ElementBackground
                        if el:FindFirstChild("UIStroke") then
                            el.UIStroke.Color = SelectedTheme.ElementStroke
                        end
                    end
                end
            end
        end

        -- Update tabs
        for _, t in ipairs(Tabs) do
            if t ~= ActiveTab then
                xtween(t.Button, { BackgroundColor3 = SelectedTheme.TabBackground }, 0.5)
                if t.Button:FindFirstChild("UIStroke") then
                    xtween(t.Button.UIStroke, { Color = SelectedTheme.TabStroke }, 0.5)
                end
                if t.Button:FindFirstChild("Image") then
                    xtween(t.Button.Image, { ImageColor3 = SelectedTheme.TabTextColor }, 0.5)
                end
                if t.Button:FindFirstChild("Title") then
                    xtween(t.Button.Title, { TextColor3 = SelectedTheme.TabTextColor }, 0.5)
                end
            end
        end
        if ActiveTab then
            xtween(ActiveTab.Button, { BackgroundColor3 = SelectedTheme.TabBackgroundSelected }, 0.5)
            if ActiveTab.Button:FindFirstChild("UIStroke") then
                xtween(ActiveTab.Button.UIStroke, { Color = SelectedTheme.TabBackgroundSelected }, 0.5)
            end
            if ActiveTab.Button:FindFirstChild("Image") then
                xtween(ActiveTab.Button.Image, { ImageColor3 = SelectedTheme.SelectedTabTextColor }, 0.5)
            end
            if ActiveTab.Button:FindFirstChild("Title") then
                xtween(ActiveTab.Button.Title, { TextColor3 = SelectedTheme.SelectedTabTextColor }, 0.5)
            end
        end
    end

    -- ============================================================
    -- WINDOW CONTROLS
    -- ============================================================
    local function setVisibility(isHidden)
        Hidden = isHidden
        Main.Visible = not isHidden
        DragBar.Visible = not isHidden
    end

    function Window:Minimize()
        if Main.Size.Y.Offset > 40 then
            xtween(Main, { Size = UDim2.new(0, 560, 0, 40) }, 0.3)
        else
            xtween(Main, { Size = UDim2.new(0, 560, 0, 390) }, 0.3)
        end
    end

    function Window:SetVisibility(isHidden)
        setVisibility(isHidden)
    end

    function Window:Destroy()
        if KismileGui then KismileGui:Destroy() end
    end

    HideBtn.MouseButton1Click:Connect(function() setVisibility(not Hidden) end)
    SizeBtn.MouseButton1Click:Connect(function() Window:Minimize() end)

    -- Toggle keybind
    local toggleKey = getSetting("General", "kismileOpen")
    if toggleKey then
        local kc = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == Enum.KeyCode[toggleKey] then
                if Debounce then return end
                setVisibility(not Hidden)
            end
        end)
        table.insert(KismileLibrary.Connections, kc)
    end

    -- Right-click title to hide
    TitleLabel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            setVisibility(not Hidden)
        end
    end)

    -- ============================================================
    -- ACTIVATE FIRST TAB
    -- ============================================================
    if FirstTab then
        FirstTab.Button.InputBegan:Fire()
    end

    -- ============================================================
    -- LOAD CONFIG
    -- ============================================================
    if CEnabled then
        task.spawn(function()
            local loaded = KismileLibrary:LoadConfigFromFile()
            if loaded then
                task.wait(1)
                KismileLibrary:Notify({
                    Title = "Kismile Config",
                    Content = "已加载之前的配置",
                    Duration = 4,
                })
            end
        end)
    end

    -- ============================================================
    -- CLEANUP
    -- ============================================================
    KismileGui.Destroying:Connect(function()
        ibEnd:Disconnect()
        rsDrag:Disconnect()
        for _, c in ipairs(KismileLibrary.Connections) do
            pcall(function() c:Disconnect() end)
        end
    end)

    self.Window = Window
    return Window
end

-- ============================================================
-- RETURN
-- ============================================================

return KismileLibrary
