                local c = KismileLibrary.Flags[ColorPickerSettings.Flag]
                if type(c) == "table" and c.R then Value = unpackColor(c) end
            end
            local IsOpen = false
            local H, S, V = Value:ToHSV()

            local elem = Instance.new("Frame")
            elem.Name = ColorPickerSettings.Name or "Color Picker"
            elem.Size = UDim2.new(1, 0, 0, 42)
            elem.BackgroundColor3 = SelectedTheme.ElementBackground
            elem.BorderSizePixel = 0
            elem.ZIndex = 5
            elem.ClipsDescendants = false
            elem.LayoutOrder = #Tab.Elements + 1
            elem.Parent = Tab.Page
