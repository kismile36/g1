    Overlay.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Overlay:Destroy()
        end
    end)

    return DialogFrame
end

-- Flag / Config system
function Kismile:SetFlag(FlagName, Value)
    self.Flags[FlagName] = Value
    if self.SaveConfig then
        self:SaveConfig()
    end
end

function Kismile:GetFlag(FlagName)
    return self.Flags[FlagName]
end

function Kismile:GetFlags()
    return self.Flags
end

function Kismile:SaveConfig()
    if not writefile then
        -- Only warn once
        if not self._configWarned then
            self._configWarned = true
        end
        return false
    end

    local ConfigPath = self.ConfigFolder .. "/" .. self.ConfigName .. ".json"
    local JsonData = Services.HttpService:JSONEncode(self.Flags)

    local Success = pcall(function()
        if not isfolder(self.ConfigFolder) then
            makefolder(self.ConfigFolder)
        end
        writefile(ConfigPath, JsonData)
    end)

    return Success
end

function Kismile:LoadConfig()
    if not readfile and not isfile then
        return false
    end

    local ConfigPath = self.ConfigFolder .. "/" .. self.ConfigName .. ".json"

    if isfile and isfile(ConfigPath) and readfile then
        local Success, Data = pcall(function()
            return readfile(ConfigPath)
        end)

        if Success and Data and #Data > 0 then
            local Success2, Parsed = pcall(function()
                return Services.HttpService:JSONDecode(Data)
            end)

            if Success2 and type(Parsed) == "table" then
                for FlagName, Value in pairs(Parsed) do
                    self.Flags[FlagName] = Value
                end
                return true
            end
        end
    end

    return false
end

-- Cleanup
function Kismile:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
        self.Window = nil
    end

    for _, Connection in ipairs(self.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end
    self.Connections = {}
end

