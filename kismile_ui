                14, Kismile.CurrentTheme.TextSecondary,
                {
                    Size = UDim2.new(0, 20, 0, 20),
                    Position = UDim2.new(1, -30, 0, 14),
                    ZIndex = 6,
                    TextXAlignment = Enum.TextXAlignment.Center,
                }
            )

            -- Options container
            local OptionList = UIUtil:Create("ScrollingFrame", {
                Size = UDim2.new(1, -16, 0, 0),
                Position = UDim2.new(0, 8, 1, -10),
                BackgroundColor3 = Kismile.CurrentTheme.DropdownBackground,
                BorderSizePixel = 0,
                ZIndex = 50,
                Visible = false,
                ScrollBarThickness = 4,
                ScrollBarImageColor3 = Kismile.CurrentTheme.ScrollbarHandle,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                Parent = Element,
            })
            UIUtil:AddCorner(OptionList, UDim.new(0, 6))
            UIUtil:AddStroke(OptionList, Kismile.CurrentTheme.ElementBorder, 1, 0.5)

            local OptListLayout = UIUtil:Create("UIListLayout", {
                Padding = UDim.new(0, 1),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = OptionList,
            })

            OptListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                OptionList.CanvasSize = UDim2.new(0, 0, 0, OptListLayout.AbsoluteContentSize.Y + 4)
            end)

            local OptionButtons = {}

            local function BuildOptions(Filter)
                Filter = type(Filter) == "string" and string.lower(Filter) or ""

                for _, Btn in ipairs(OptionButtons) do
                    Btn:Destroy()
                end
                OptionButtons = {}

                local VisibleCount = 0
                for _, Option in ipairs(Options) do
                    if Filter == "" or string.find(string.lower(Option), Filter, 1, true) then
                        VisibleCount = VisibleCount + 1

                        local IsSelected = MultiSelect and table.find(Value or {}, Option)
                            or (not MultiSelect and Value == Option)

                        local OptionBtn = UIUtil:Create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = IsSelected and Kismile.CurrentTheme.DropdownOptionSelected
                                or Kismile.CurrentTheme.DropdownOption,
                            Text = "",
                            BorderSizePixel = 0,
                            ZIndex = 51,
                            LayoutOrder = VisibleCount,
                            Parent = OptionList,
                        })
                        UIUtil:AddCorner(OptionBtn, UDim.new(0, 4))

                        if MultiSelect then
                            UIUtil:CreateText(OptionBtn, IsSelected and "a" or "o",
                                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                                12, IsSelected and Kismile.CurrentTheme.Accent or Kismile.CurrentTheme.TextDark,
                                {
                                    Size = UDim2.new(0, 20, 1, 0),
                                    Position = UDim2.new(0, 4, 0, 0),
                                    ZIndex = 52,
                                    TextXAlignment = Enum.TextXAlignment.Center,
                                }
                            )
                        end

                        UIUtil:CreateText(OptionBtn, Option,
                            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                            12, IsSelected and Kismile.CurrentTheme.Accent or Kismile.CurrentTheme.TextColor,
                            {
                                Size = UDim2.new(1, MultiSelect and -30 or -12, 1, 0),
                                Position = UDim2.new(0, MultiSelect and 26 or 8, 0, 0),
                                ZIndex = 52,
                                TextTruncate = Enum.TextTruncate.AtEnd,
                            }
                        )

                        OptionBtn.MouseButton1Click:Connect(function()
                            if MultiSelect then
                                local Found = table.find(Value, Option)
                                if Found then
                                    table.remove(Value, Found)
                                else
                                    table.insert(Value, Option)
                                end
                            else
                                Value = Option
                                IsOpen = false
                                OptionList.Visible = false
                                Animation:Tween(OptionList, { Size = UDim2.new(1, -16, 0, 0) }, 0.15)
                                Arrow.Rotation = 0
                            end
                            SelectedLabel.Text = GetSelectedText()

                            if DropdownSettings.Flag then
                                Kismile:SetFlag(DropdownSettings.Flag, Value)
                            end
                            if DropdownSettings.Callback then
                                DropdownSettings.Callback(Value)
                            end

                            BuildOptions(Filter)
                        end)

                        OptionBtn.MouseEnter:Connect(function()
                            Animation:Tween(OptionBtn, { BackgroundColor3 = Kismile.CurrentTheme.DropdownOptionHover }, 0.1)
                        end)
                        OptionBtn.MouseLeave:Connect(function()
                            local CurrSel = MultiSelect and table.find(Value or {}, Option)
                                or (not MultiSelect and Value == Option)
                            Animation:Tween(OptionBtn, {
                                BackgroundColor3 = CurrSel and Kismile.CurrentTheme.DropdownOptionSelected
                                    or Kismile.CurrentTheme.DropdownOption
                            }, 0.1)
                        end)

                        table.insert(OptionButtons, OptionBtn)
                    end
                end

                OptionList.CanvasSize = UDim2.new(0, 0, 0, VisibleCount * 29 + 4)
                if not IsOpen then
                    OptionList.Size = UDim2.new(1, -16, 0, 0)
                end
            end

            BuildOptions()

            local function ToggleDropdown()
                IsOpen = not IsOpen
                if IsOpen then
                    OptionList.Visible = true
                    BuildOptions()
                    local TargetH = math.min(#Options * 29 + 2, 180)
                    Animation:Tween(OptionList, { Size = UDim2.new(1, -16, 0, TargetH) }, 0.2, Enum.EasingStyle.Quart)
                    Animation:Tween(Arrow, { Rotation = 180 }, 0.2)
