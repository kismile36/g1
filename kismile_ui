-- ========================================
-- SECTION 1: Environment & Services
-- ========================================

local Environment = {
    RenderStepped = nil,
    Heartbeat = nil,
    IsStudio = false,
    IsSynapse = false,
    IsKrnl = false,
    IsScriptWare = false,
    IsElectron = false,
    IsFluxus = false,
    IsCodex = false,
    HookFunction = nil,
    GetCustomAsset = nil,
    HttpGet = nil,
    GetHiddenUI = nil,
}

-- Detect executor environment
if identifyexecutor then
    local Executor = identifyexecutor()
    Environment.IsSynapse = Executor == "Synapse"
    Environment.IsKrnl = Executor == "Krnl"
    Environment.IsScriptWare = Executor == "ScriptWare"
    Environment.IsElectron = Executor == "Electron"
    Environment.IsFluxus = Executor == "Fluxus"
    Environment.IsCodex = Executor == "Codex"
end

if syn and syn.request then
    Environment.HttpGet = function(Url)
        local Response = syn.request({ Url = Url, Method = "GET" })
        return Response.Body
    end
elseif request then
    Environment.HttpGet = function(Url)
        local Response = request({ Url = Url, Method = "GET" })
        return Response.Body
    end
else
    Environment.HttpGet = function(Url)
        return game:HttpGet(Url)
    end
end

if gethui then
    Environment.GetHiddenUI = gethui
elseif syn and syn.protect_gui then
    Environment.GetHiddenUI = function()
        local HiddenUI = syn.protect_gui(Instance.new("ScreenGui"))
        syn.protect_gui(HiddenUI)
        return HiddenUI
    end
elseif get_hidden_gui then
    Environment.GetHiddenUI = get_hidden_gui
elseif get_gui then
    Environment.GetHiddenUI = get_gui
else
    Environment.GetHiddenUI = function()
        return game:GetService("CoreGui")
    end
end

if hookfunction then
    Environment.HookFunction = hookfunction
end

if getcustomasset then
    Environment.GetCustomAsset = getcustomasset
end

Environment.RenderStepped = game:GetService("RunService").RenderStepped
Environment.Heartbeat = game:GetService("RunService").Heartbeat
Environment.IsStudio = game:GetService("RunService"):IsStudio()

-- Services
local Services = {
    TweenService = game:GetService("TweenService"),
    UserInputService = game:GetService("UserInputService"),
    Players = game:GetService("Players"),
    TextService = game:GetService("TextService"),
    HttpService = game:GetService("HttpService"),
    CoreGui = game:GetService("CoreGui"),
    RunService = game:GetService("RunService"),
    StarterGui = game:GetService("StarterGui"),
}

local LocalPlayer = Services.Players.LocalPlayer

-- Cloneref fallback
local Cloneref = cloneref or clonereference or function(Obj)
    return Obj
end

