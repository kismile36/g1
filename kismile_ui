local CEnabled = false
local CFileName = nil
local globalLoaded = false
local Tabs = {}
local ActiveTab = nil
local FirstTab = nil
local Debounce = false

function KismileLibrary:CreateWindow(Settings)
    Settings = Settings or {}
    local Hidden = false

    -- Configuration
    if Settings.ConfigurationSaving and Settings.ConfigurationSaving.Enabled then
        CEnabled = true
        CFileName = Settings.ConfigurationSaving.FileName or tostring(game.PlaceId)
        if Settings.ConfigurationSaving.FolderName then
            ConfigurationFolder = "Kismile/" .. Settings.ConfigurationSaving.FolderName
        end
    else
        CEnabled = false
        CFileName = nil
    end
    self.ConfigFileName = CFileName

    -- Theme
    if Settings.Theme then
        ChangeTheme(Settings.Theme)
    end

    -- Key system
    if Settings.KeySystem then
        local keyOk = false
        local hwid = getHWID()
        local ks = Settings.KeySystem

        -- Try saved key
        if ks.SaveKey and isfile and readfile then
            local keyPath = "Kismile/KeySystem/" .. (ks.FileName or "Key_" .. hwid) .. ".key"
            if callSafely(isfile, keyPath) then
                local savedKey = callSafely(readfile, keyPath)
                if savedKey then
                    -- Check against static keys
                    if ks.Key then
                        if type(ks.Key) == "table" then
                            keyOk = table.find(ks.Key, savedKey) ~= nil
                        else
                            keyOk = tostring(ks.Key) == savedKey
                        end
                    end
                    -- Check via validator
                    if not keyOk and ks.KeyValidator then
                        keyOk = ks.KeyValidator(savedKey) == true
                    end
                    -- Check via API
                    if not keyOk and ks.GrabKeyFromSite then
                        local apiKey = requestGet(ks.Key)
                        if apiKey then
                            keyOk = apiKey:find(savedKey, 1, true) ~= nil
                        end
                    end
                end
            end
        end

        -- If no saved key works, show key UI
        if not keyOk then
            -- Block until key is valid (Wind UI style)
            -- Create temporary ScreenGui for key input
            local keyGui = Instance.new("ScreenGui")
            keyGui.Parent = getHiddenUI()
            keyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

            local keyFrame = Instance.new("Frame")
            keyFrame.Size = UDim2.new(1, 0, 1, 0)
            keyFrame.BackgroundColor3 = SelectedTheme.Background
            keyFrame.BorderSizePixel = 0
            keyFrame.Parent = keyGui

            createText(keyFrame, ks.Title or "Key System",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                24, SelectedTheme.Accent,
                { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.45, 0), TextXAlignment = Enum.TextXAlignment.Center }
            )

            createText(keyFrame, ks.Subtitle or "Enter your key to continue",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                14, SelectedTheme.TextColor,
                { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.45, 35), TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.3 }
            )

            local kInput = Instance.new("TextBox")
            kInput.Size = UDim2.new(0, 240, 0, 36)
            kInput.Position = UDim2.new(0.5, -120, 0.5, -18)
            kInput.PlaceholderText = ks.Note or "Key..."
            kInput.PlaceholderColor3 = SelectedTheme.PlaceholderColor
            kInput.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)
            kInput.TextSize = 13
            kInput.TextColor3 = SelectedTheme.TextColor
            kInput.BackgroundColor3 = SelectedTheme.InputBackground
            kInput.Text = ""
            kInput.BorderSizePixel = 0
            kInput.Parent = keyFrame
            addCorner(kInput, UDim.new(0, 8))
            addStroke(kInput, SelectedTheme.InputStroke, 1.5, 0)

            local kBtn = Instance.new("TextButton")
            kBtn.Size = UDim2.new(0, 240, 0, 36)
            kBtn.Position = UDim2.new(0.5, -120, 0.5, 28)
            kBtn.BackgroundColor3 = SelectedTheme.Accent
            kBtn.Text = ks.ButtonText or "Submit"
            kBtn.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
            kBtn.TextSize = 13
            kBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            kBtn.BorderSizePixel = 0
            kBtn.Parent = keyFrame
            addCorner(kBtn, UDim.new(0, 8))

            local kStatus = createText(keyFrame, "",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                12, Color3.fromRGB(255, 70, 70),
                { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0.5, 75), TextXAlignment = Enum.TextXAlignment.Center }
            )

            local function validateKey(inputKey)
                if inputKey == "" then
                    kStatus.Text = "Please enter a key"
                    return
                end
                local valid = false
                if ks.Key then
                    if type(ks.Key) == "table" then
                        valid = table.find(ks.Key, inputKey) ~= nil
                    else
                        valid = tostring(ks.Key) == inputKey
                    end
                end
                if not valid and ks.KeyValidator then
                    valid = ks.KeyValidator(inputKey) == true
                end
                if not valid and ks.GrabKeyFromSite then
                    local apiKey = requestGet(ks.Key)
                    if apiKey then valid = apiKey:find(inputKey, 1, true) ~= nil end
                end
                if valid then
                    if ks.SaveKey and writefile then
                        ensureFolder("Kismile/KeySystem")
                        writefile("Kismile/KeySystem/" .. (ks.FileName or "Key_" .. hwid) .. ".key", inputKey)
                    end
                    keyGui:Destroy()
                else
                    kStatus.Text = "Invalid key"
                end
            end

            kBtn.MouseButton1Click:Connect(function() validateKey(kInput.Text) end)
            kInput.FocusLost:Connect(function(entered)
                if entered then validateKey(kInput.Text) end
            end)

            -- Wait for key validation
            repeat task.wait() until not keyGui or not keyGui.Parent
        end
    end

