            arrow.Position = UDim2.new(1, -24, 0.5, -8)
            arrow.BackgroundTransparency = 1
            arrow.ImageColor3 = SelectedTheme.TextColor
            arrow.ZIndex = 6
            arrow.Parent = elem

            -- Options
            local optList = Instance.new("ScrollingFrame")
            optList.Name = "Options"
            optList.Size = UDim2.new(1, -4, 0, 0)
            optList.Position = UDim2.new(0, 2, 1, -4)
            optList.BackgroundColor3 = SelectedTheme.ElementBackground
            optList.BorderSizePixel = 0
            optList.ZIndex = 50
            optList.Visible = false
            optList.ScrollBarThickness = 3
            optList.ScrollBarImageColor3 = SelectedTheme.ElementStroke
            optList.CanvasSize = UDim2.new(0, 0, 0, 0)
            optList.Parent = elem
            addCorner(optList, UDim.new(0, 4))
            addStroke(optList, SelectedTheme.ElementStroke, 1.5, 0)

            local optLayout = Instance.new("UIListLayout")
            optLayout.Padding = UDim.new(0, 1)
            optLayout.SortOrder = Enum.SortOrder.LayoutOrder
            optLayout.Parent = optList
            optLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                optList.CanvasSize = UDim2.new(0, 0, 0, optLayout.AbsoluteContentSize.Y + 2)
            end)

            local optBtns = {}
            local function rebuild()
                for _, b in ipairs(optBtns) do b:Destroy() end
                optBtns = {}
                for _, o in ipairs(Options) do
                    local isSel = Multi and table.find(Value, o) or (not Multi and Value == o)
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 26)
                    btn.BackgroundColor3 = isSel and SelectedTheme.DropdownSelected or SelectedTheme.DropdownUnselected
                    btn.Text = ""
                    btn.BorderSizePixel = 0
                    btn.ZIndex = 51
                    btn.Parent = optList
                    addCorner(btn, UDim.new(0, 4))

                    createText(btn, o,
                        Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                        11, isSel and (SelectedTheme.Accent or SelectedTheme.SliderProgress) or SelectedTheme.TextColor,
                        { Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 52 }
                    )

                    btn.MouseButton1Click:Connect(function()
                        if Multi then
                            local f = table.find(Value, o)
                            if f then table.remove(Value, f) else table.insert(Value, o) end
                        else
                            Value = o
                            IsOpen = false; optList.Visible = false
                            xtween(optList, { Size = UDim2.new(1, -4, 0, 0) }, 0.1)
                            xtween(arrow, { Rotation = 0 }, 0.1)
                        end
                        selLabel.Text = getDisplay()
                        if DropdownSettings.Flag then
                            KismileLibrary.Flags[DropdownSettings.Flag] = (Multi and Value or Value)
                        end
                        if DropdownSettings.Callback then
                            DropdownSettings.Callback(Multi and Value or Value)
                        end
                        rebuild()
                    end)
                    table.insert(optBtns, btn)
                end
            end

            rebuild()

            local function toggle()
                IsOpen = not IsOpen
                if IsOpen then
                    optList.Visible = true
                    local h = math.min(#Options * 27 + 2, 150)
                    xtween(optList, { Size = UDim2.new(1, -4, 0, h) }, 0.15)
                    xtween(arrow, { Rotation = 180 }, 0.15)
                else
                    xtween(arrow, { Rotation = 0 }, 0.15)
                    xtween(optList, { Size = UDim2.new(1, -4, 0, 0) }, 0.1)
                    task.delay(0.1, function() if not IsOpen then optList.Visible = false end end)
                end
            end

            elem.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then toggle() end
