            panel.BorderSizePixel = 0
            panel.Parent = elem
            addCorner(panel, UDim.new(0, 4))
            addStroke(panel, SelectedTheme.ElementStroke, 1.5, 0)

            -- Hue bar
            local hBar = Instance.new("Frame")
            hBar.Size = UDim2.new(1, -12, 0, 14)
            hBar.Position = UDim2.new(0, 6, 0, 10)
            hBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hBar.BorderSizePixel = 0
            hBar.ZIndex = 51
            hBar.Parent = panel
            addCorner(hBar, UDim.new(0, 7))
            for i = 0, 30 do
                local b = Instance.new("Frame")
                b.Size = UDim2.new(1 / 31, 0, 1, 0)
                b.Position = UDim2.new(i / 31, 0, 0, 0)
                b.BackgroundColor3 = Color3.fromHSV(i / 31, 1, 1)
                b.BorderSizePixel = 0; b.ZIndex = 51; b.Parent = hBar
            end
            local hPtr = Instance.new("Frame")
            hPtr.Size = UDim2.new(0, 3, 1.4, 0)
            hPtr.Position = UDim2.new(H, -1.5, -0.2, 0)
            hPtr.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hPtr.BorderSizePixel = 0; hPtr.ZIndex = 53; hPtr.Parent = hBar
            addCorner(hPtr, UDim.new(0, 2)); addStroke(hPtr, Color3.fromRGB(0, 0, 0), 1, 0.5)

            -- SV grid
            local svGrid = Instance.new("Frame")
            svGrid.Size = UDim2.new(1, -12, 0, 78)
            svGrid.Position = UDim2.new(0, 6, 0, 32)
            svGrid.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
            svGrid.BorderSizePixel = 0; svGrid.ZIndex = 51; svGrid.Parent = panel
            addCorner(svGrid, UDim.new(0, 4))

            -- White gradient (Saturation axis)
            local svW = Instance.new("Frame")
            svW.Size = UDim2.new(1, 0, 1, 0)
            svW.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            svW.BackgroundTransparency = 1; svW.BorderSizePixel = 0; svW.ZIndex = 51; svW.Parent = svGrid
            local gW = Instance.new("UIGradient", svW)
            gW.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })

            -- Black gradient (Value axis)
            local svB = Instance.new("Frame")
            svB.Size = UDim2.new(1, 0, 1, 0)
            svB.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            svB.BackgroundTransparency = 1; svB.BorderSizePixel = 0; svB.ZIndex = 51; svB.Parent = svGrid
            local gB = Instance.new("UIGradient", svB)
            gB.Rotation = 90
            gB.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })

            local svPtr = Instance.new("Frame")
            svPtr.Size = UDim2.new(0, 8, 0, 8)
            svPtr.Position = UDim2.new(S, -4, 1 - V, -4)
            svPtr.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            svPtr.BorderSizePixel = 0; svPtr.ZIndex = 53; svPtr.Parent = svGrid
            addCorner(svPtr, UDim.new(1, 0)); addStroke(svPtr, Color3.fromRGB(0, 0, 0), 1, 0.5)

            local updateFunc
            local function trigger()
                Value = Color3.fromHSV(H, S, V)
                prev.BackgroundColor3 = Value
                if ColorPickerSettings.Flag then
                    KismileLibrary.Flags[ColorPickerSettings.Flag] = packColor(Value)
                end
                if ColorPickerSettings.Callback then ColorPickerSettings.Callback(Value) end
            end
            updateFunc = trigger

            local hDrag = false
            local function setH(mx)
                local r = math.clamp((mx - hBar.AbsolutePosition.X) / hBar.AbsoluteSize.X, 0, 1)
                H = r; hPtr.Position = UDim2.new(H, -1.5, -0.2, 0)
                svGrid.BackgroundColor3 = Color3.fromHSV(H, 1, 1); trigger()
            end
            hBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hDrag = true; setH(i.Position.X) end end)

            local svDrag = false
            local function setSV(mx, my)
                S = math.clamp((mx - svGrid.AbsolutePosition.X) / svGrid.AbsoluteSize.X, 0, 1)
                V = math.clamp(1 - (my - svGrid.AbsolutePosition.Y) / svGrid.AbsoluteSize.Y, 0, 1)
                svPtr.Position = UDim2.new(S, -4, 1 - V, -4); trigger()
            end
            svGrid.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = true; setSV(i.Position.X, i.Position.Y) end end)

            local mc = UserInputService.InputChanged:Connect(function(i)
                if hDrag and i.UserInputType == Enum.UserInputType.MouseMovement then setH(i.Position.X) end
                if svDrag and i.UserInputType == Enum.UserInputType.MouseMovement then setSV(i.Position.X, i.Position.Y) end
            end)
            local ec = UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then hDrag = false; svDrag = false end
            end)
            elem.Destroying:Connect(function() mc:Disconnect(); ec:Disconnect() end)

            elem.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    IsOpen = not IsOpen
                    if IsOpen then
                        panel.Visible = true
                        xtween(panel, { Size = UDim2.new(1, -4, 0, 126) }, 0.15)
                    else
                        xtween(panel, { Size = UDim2.new(1, -4, 0, 0) }, 0.1)
                        task.delay(0.1, function() if not IsOpen then panel.Visible = false end end)
                    end
                end
            end)

            bindElement(elem, function(c)
                if type(c) == "table" and c.R then c = unpackColor(c) end
                Value = c; prev.BackgroundColor3 = Value
                H, S, V = Value:ToHSV()
                hPtr.Position = UDim2.new(H, -1.5, -0.2, 0)
                svGrid.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
                svPtr.Position = UDim2.new(S, -4, 1 - V, -4)
            end)

            table.insert(Tab.Elements, elem)
            return elem
        end

