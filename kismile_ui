            end)

            Element.MouseEnter:Connect(function()
                Animation:Tween(Element, { BackgroundColor3 = ButtonSettings.Color or Kismile.CurrentTheme.ButtonHover }, 0.15)
            end)
            Element.MouseLeave:Connect(function()
                Animation:Tween(Element, { BackgroundColor3 = ButtonSettings.Color or Kismile.CurrentTheme.ButtonBackground }, 0.15)
            end)

            table.insert(self.Elements, Element)
            return Element
        end

        -- Label
        function Tab:CreateLabel(LabelSettings)
            LabelSettings = LabelSettings or {}

            local Element = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -20, 0, 32),
                BackgroundColor3 = Kismile.CurrentTheme.ElementBackground,
                BorderSizePixel = 0,
                LayoutOrder = #self.Elements + 1,
                ZIndex = 5,
                Parent = self.Scroll,
            })
            UIUtil:AddCorner(Element, UDim.new(0, 8))
            UIUtil:AddStroke(Element, Kismile.CurrentTheme.ElementBorder, 1, 0.5)

            local OffsetX = 12
            if LabelSettings.Icon then
                UIUtil:CreateText(Element, "o",
                    Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                    14, LabelSettings.Color or Kismile.CurrentTheme.Accent,
                    {
                        Size = UDim2.new(0, 20, 0, 20),
                        Position = UDim2.new(0, 12, 0.5, -10),
                        ZIndex = 6,
                        TextXAlignment = Enum.TextXAlignment.Center,
                    }
                )
                OffsetX = 38
            end

            local LabelText = UIUtil:CreateText(Element, LabelSettings.Title or "Label",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                13, LabelSettings.Color or Kismile.CurrentTheme.TextColor,
                {
                    Size = UDim2.new(1, -OffsetX - 12, 0, 20),
                    Position = UDim2.new(0, OffsetX, 0.5, -10),
                    ZIndex = 6,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }
            )

            Element.SetText = function(self, NT) LabelText.Text = NT end

            table.insert(self.Elements, Element)
            return Element
        end

        -- Paragraph
        function Tab:CreateParagraph(ParagraphSettings)
            ParagraphSettings = ParagraphSettings or {}

            local Element = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -20, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Kismile.CurrentTheme.ElementBackground,
                BorderSizePixel = 0,
                ZIndex = 5,
                LayoutOrder = #self.Elements + 1,
                Parent = self.Scroll,
            })
            UIUtil:AddCorner(Element, UDim.new(0, 8))
            UIUtil:AddStroke(Element, Kismile.CurrentTheme.ElementBorder, 1, 0.5)

            UIUtil:Create("UIPadding", {
                PaddingTop = UDim.new(0, 10),
                PaddingBottom = UDim.new(0, 10),
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12),
                Parent = Element,
            })

            UIUtil:CreateText(Element, ParagraphSettings.Title or "Paragraph",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
                13, Kismile.CurrentTheme.TextColor,
                { Size = UDim2.new(1, 0, 0, 18), ZIndex = 6 }
            )

            local ContentLabel = UIUtil:CreateText(Element, ParagraphSettings.Content or "",
                Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                12, Kismile.CurrentTheme.TextSecondary,
                {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 0, 22),
                    TextWrapped = true,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    ZIndex = 6,
                    LineHeight = 1.4,
                }
            )

            Element.SetContent = function(self, NC) ContentLabel.Text = NC end

            table.insert(self.Elements, Element)
            return Element
        end

        -- Divider
        function Tab:CreateDivider(DividerText)
            local Element = UIUtil:Create("Frame", {
                Size = UDim2.new(1, -20, 0, 20),
                BackgroundTransparency = 1,
                ZIndex = 5,
                LayoutOrder = #self.Elements + 1,
                Parent = self.Scroll,
            })

            UIUtil:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                Position = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = Kismile.CurrentTheme.SectionLine,
                BorderSizePixel = 0,
                Parent = Element,
            })

            if DividerText then
                UIUtil:CreateText(Element, DividerText,
                    Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
                    11, Kismile.CurrentTheme.TextDark,
                    {
                        Size = UDim2.new(0, 0, 1, 0),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Position = UDim2.new(0.5, 0, 0, 0),
                        BackgroundColor3 = Kismile.CurrentTheme.Content,
                        BackgroundTransparency = 0,
                        ZIndex = 6,
                        TextXAlignment = Enum.TextXAlignment.Center,
                    }
                )
            end

            table.insert(self.Elements, Element)
            return Element
        end

        table.insert(self.Tabs, Tab)
        return Tab
    end

    function Window:ActivateTab(Tab)
        if self.ActiveTab then
            Animation:Tween(self.ActiveTab.Button, { BackgroundColor3 = Kismile.CurrentTheme.Tab }, 0.15)
            for _, Child in ipairs(self.ActiveTab.Button:GetChildren()) do
                if Child:IsA("TextLabel") then
                    Animation:Tween(Child, { TextColor3 = Kismile.CurrentTheme.TabText }, 0.15)
                elseif Child:IsA("Frame") and Child.Size == UDim2.new(0, 3, 0, 20) then
                    Animation:Tween(Child, { BackgroundTransparency = 1 }, 0.15)
                end
            end
            self.ActiveTab.Page.Visible = false
        end

        self.ActiveTab = Tab
        Animation:Tween(Tab.Button, { BackgroundColor3 = Kismile.CurrentTheme.TabActive }, 0.15)
        for _, Child in ipairs(Tab.Button:GetChildren()) do
            if Child:IsA("TextLabel") then
                Animation:Tween(Child, { TextColor3 = Kismile.CurrentTheme.TabTextActive }, 0.15)
            elseif Child:IsA("Frame") and Child.Size == UDim2.new(0, 3, 0, 20) then
                Animation:Tween(Child, { BackgroundTransparency = 0 }, 0.15)
            end
        end
        Tab.Page.Visible = true
    end

    function Window:Minimize()
        Kismile.IsMinimized = true
        Animation:Tween(self.MainFrame, { Size = UDim2.new(0, 600, 0, 40) }, 0.3, Enum.EasingStyle.Quart)
    end
    function Window:Maximize()
        Kismile.IsMinimized = false
        Animation:Tween(self.MainFrame, { Size = UDim2.new(0, 600, 0, 420) }, 0.3, Enum.EasingStyle.Quart)
    end
    function Window:Hide()
        Kismile.IsHidden = true; self.MainFrame.Visible = false
    end
    function Window:Unhide()
        Kismile.IsHidden = false; self.MainFrame.Visible = true
    end
    function Window:Destroy()
        Kismile:Destroy()
    end

    -- Loading animation
    if Settings.LoadingTitle and Settings.LoadingSubtitle then
        local LoadingFrame = UIUtil:Create("Frame", {
            Name = "KismileLoading",
            Size = UDim2.new(1, 0, 1, -40),
            Position = UDim2.new(0, 0, 0, 40),
            BackgroundColor3 = Kismile.CurrentTheme.Background,
            BorderSizePixel = 0, ZIndex = 99,
            Parent = MainFrame,
        })
        UIUtil:CreateText(LoadingFrame, Settings.LoadingTitle,
            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
            24, Kismile.CurrentTheme.Accent,
            { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.5, -35), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 100 }
        )
        UIUtil:CreateText(LoadingFrame, Settings.LoadingSubtitle,
            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
            13, Kismile.CurrentTheme.TextSecondary,
            { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 100 }
        )
        local Spinner = UIUtil:Create("Frame", {
            Size = UDim2.new(0, 50, 0, 10),
            Position = UDim2.new(0.5, -25, 0.5, 30),
            BackgroundTransparency = 1, ZIndex = 100,
            Parent = LoadingFrame,
        })
        for I = 1, 3 do
            local Dot = UIUtil:Create("Frame", {
                Size = UDim2.new(0, 8, 0, 8),
                Position = UDim2.new(0, (I - 1) * 20, 0, 1),
                BackgroundColor3 = Kismile.CurrentTheme.Accent,
                BorderSizePixel = 0, ZIndex = 101,
                Parent = Spinner,
            })
            UIUtil:AddCorner(Dot, UDim.new(1, 0))
            task.spawn(function()
                while LoadingFrame and LoadingFrame.Parent do
                    local S = 1 + math.sin(tick() * 5 + I) * 0.3
                    Dot.Size = UDim2.new(0, 8 * S, 0, 8 * S)
                    task.wait(0.04)
                end
            end)
        end
        task.delay(1.5, function()
            if LoadingFrame and LoadingFrame.Parent then
                Animation:Tween(LoadingFrame, { BackgroundTransparency = 1 }, 0.3)
                task.delay(0.3, function() LoadingFrame:Destroy() end)
            end
        end)
    end

    -- Key System UI
    if Settings.KeySystem then
        local KS = Settings.KeySystem
        local KeyFrame = UIUtil:Create("Frame", {
            Name = "KeySystemFrame",
            Size = UDim2.new(1, 0, 1, -40),
            Position = UDim2.new(0, 0, 0, 40),
            BackgroundColor3 = Kismile.CurrentTheme.Background,
            BorderSizePixel = 0, ZIndex = 99,
            Parent = MainFrame,
        })
        UIUtil:CreateText(KeyFrame, KS.Title or "Key System",
            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
            22, Kismile.CurrentTheme.Accent,
            { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.5, -55), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 100 }
        )
        UIUtil:CreateText(KeyFrame, KS.Subtitle or "Enter your key",
            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
            13, Kismile.CurrentTheme.TextSecondary,
            { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0.5, -22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 100 }
        )
        local KeyInput = UIUtil:Create("TextBox", {
            Size = UDim2.new(0, 200, 0, 34),
            Position = UDim2.new(0.5, -100, 0.5, 5),
            BackgroundColor3 = Kismile.CurrentTheme.InputBackground,
            PlaceholderText = KS.Note or "Key...",
            PlaceholderColor3 = Kismile.CurrentTheme.InputPlaceholder,
            FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
            TextSize = 14, TextColor3 = Kismile.CurrentTheme.TextColor,
            ClearTextOnFocus = false, Text = "",
            ZIndex = 100, BorderSizePixel = 0,
            Parent = KeyFrame,
        })
        UIUtil:AddCorner(KeyInput, UDim.new(0, 8))
        UIUtil:AddStroke(KeyInput, Kismile.CurrentTheme.InputBorder, 1, 0.5)
        local SubmitBtn = UIUtil:Create("TextButton", {
            Size = UDim2.new(0, 200, 0, 36),
            Position = UDim2.new(0.5, -100, 0.5, 48),
            BackgroundColor3 = Kismile.CurrentTheme.Accent,
            Text = KS.ButtonText or "Submit",
            FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
            TextSize = 14, TextColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0, ZIndex = 100,
            Parent = KeyFrame,
        })
        UIUtil:AddCorner(SubmitBtn, UDim.new(0, 8))
        local StatusLabel = UIUtil:CreateText(KeyFrame, "",
            Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal),
            12, Color3.fromRGB(255, 80, 80),
            { Size = UDim2.new(1, -40, 0, 18), Position = UDim2.new(0, 20, 0.5, 92), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 100 }
        )
        local function ValidateAndSubmit()
            local InputKey = KeyInput.Text
            if InputKey == "" then StatusLabel.Text = "Please enter a key"; return end
            local Valid = false
            if KS.Key then
                if type(KS.Key) == "table" then Valid = table.find(KS.Key, InputKey) ~= nil
                else Valid = tostring(KS.Key) == InputKey end
            end
            if not Valid and KS.KeyValidator then Valid = KS.KeyValidator(InputKey) == true end
            if Valid then
                if KS.SaveKey and writefile then
                    local HWID = gethwid and gethwid() or LocalPlayer.UserId
                    local Path = "Kismile/" .. (KS.Folder or "Keys") .. "/" .. tostring(HWID) .. ".key"
                    if not isfolder("Kismile/" .. (KS.Folder or "Keys")) then makefolder("Kismile/" .. (KS.Folder or "Keys")) end
                    writefile(Path, InputKey)
                end
                Animation:Tween(KeyFrame, { BackgroundTransparency = 1 }, 0.3)
                task.delay(0.3, function() KeyFrame:Destroy() end)
            else
                StatusLabel.Text = "Invalid key"
                Animation:Tween(KeyInput, { BackgroundColor3 = Color3.fromRGB(60, 20, 20) }, 0.1)
                task.delay(0.3, function() Animation:Tween(KeyInput, { BackgroundColor3 = Kismile.CurrentTheme.InputBackground }, 0.2) end)
            end
        end
        SubmitBtn.MouseButton1Click:Connect(ValidateAndSubmit)
        KeyInput.FocusLost:Connect(function(E) if E then ValidateAndSubmit() end end)
    end

    if #Window.Tabs > 0 then Window:ActivateTab(Window.Tabs[1]) end
    return Window
end

function Kismile:Minimize() if self.Window then self.Window:Minimize() end end
function Kismile:Maximize() if self.Window then self.Window:Maximize() end end
function Kismile:Hide() if self.Window then self.Window:Hide() end end
function Kismile:Unhide() if self.Window then self.Window:Unhide() end end

return Kismile
