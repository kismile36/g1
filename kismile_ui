-- Apply theme to instance recursively
function UIUtil:ApplyTheme(Instance, Theme)
    local ThemeTag = Instance:GetAttribute("KismileThemeTag")
    if ThemeTag and Theme[ThemeTag] then
        if Instance:IsA("ScrollingFrame") or Instance:IsA("Frame") or Instance:IsA("ImageLabel") then
            Instance.BackgroundColor3 = Theme[ThemeTag]
        elseif Instance:IsA("TextLabel") or Instance:IsA("TextButton") then
            local Tag = ThemeTag
            if Tag == "Accent" or Tag == "AccentLight" or Tag == "AccentDark" then
                Instance.TextColor3 = Theme[Tag]
            end
        elseif Instance:IsA("UIStroke") then
            Instance.Color = Theme[ThemeTag]
        end
    end

    for _, Child in ipairs(Instance:GetChildren()) do
        UIUtil:ApplyTheme(Child, Theme)
    end
end

