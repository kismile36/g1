-- Signal class
local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({ _listeners = {} }, Signal)
end

function Signal:Connect(fn)
    table.insert(self._listeners, fn)
    return {
        Disconnect = function()
            for i, f in ipairs(self._listeners) do
                if f == fn then table.remove(self._listeners, i); break end
            end
        end
    }
end

function Signal:Fire(...)
    for _, fn in ipairs(self._listeners) do
        task.spawn(fn, ...)
    end
end

function Signal:Destroy()
    self._listeners = {}
end

-- Spring class (Flipper port)
local Spring = {}
Spring.__index = Spring

function Spring.new(initialValue, config)
    config = config or {}
    return setmetatable({
        _value = initialValue,
        _target = initialValue,
        _velocity = 0,
        _frequency = config.frequency or 4,
        _damping = config.damping or 0.7,
        _position = initialValue,
        _completed = false,
        _onStep = Signal.new(),
        _connection = nil,
    }, Spring)
end

function Spring:setGoal(target)
    self._target = target
    self._completed = false
    if not self._connection then
        self._connection = RunService.RenderStepped:Connect(function(dt)
            self:_step(dt)
        end)
    end
end

function Spring:_step(dt)
    if self._completed then return end

    local f = self._frequency
    local d = self._damping
    local t = self._target
    local p = self._position
    local v = self._velocity or 0

    local stiffness = f * f * 4 * math.pi * math.pi
    local damping = d * 4 * math.pi * f

    local springForce = stiffness * (t - p)
    local dampingForce = damping * v
    local totalForce = springForce - dampingForce

    local acceleration = totalForce

    self._velocity = v + acceleration * dt
    self._position = p + self._velocity * dt

    if math.abs(self._position - t) < 0.001 and math.abs(self._velocity) < 0.01 then
        self._position = t
        self._velocity = 0
        self._completed = true
        if self._connection then
            self._connection:Disconnect()
            self._connection = nil
        end
    end

    -- Apply value based on type
    if typeof(self._value) == "UDim2" and typeof(self._position) == "number" then
        -- Interpolate UDim2 based on a single number (for scale changes)
        -- We store the initial as a whole UDim2 and interpolate
    else
        self._value = self._position
    end

    self._onStep:Fire(self._value)
end

function Spring:getValue()
    return self._value
end

function Spring:destroy()
    if self._connection then
        self._connection:Disconnect()
        self._connection = nil
    end
    self._onStep:Destroy()
end

-- Quick spring drivers for common use cases
local function springNumber(initial, config)
    local s = Spring.new(initial, config)
    return {
        setGoal = function(v) s:setGoal(v) end,
        getValue = function() return s:getValue() end,
        onStep = s._onStep,
        destroy = function() s:destroy() end,
    }
end

-- Tween helper (Rayfield style - Exponential easing)
local function tween(inst, props, duration, easingStyle, easingDir)
    local info = TweenInfo.new(
        duration or 0.5,
        easingStyle or Enum.EasingStyle.Quart,
        easingDir or Enum.EasingDirection.Out,
        0, false, 0
    )
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

-- Quick exponential tween (Rayfield's preferred easing)
local function xtween(inst, props, duration)
    return tween(inst, props, duration or 0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
end

