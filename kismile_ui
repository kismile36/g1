local Animation = {}

-- Quick tween wrapper
function Animation:Tween(Instance, Properties, Duration, EasingStyle, EasingDirection)
    local TweenInfo = TweenInfo.new(
        Duration or 0.3,
        EasingStyle or Enum.EasingStyle.Quart,
        EasingDirection or Enum.EasingDirection.Out,
        0,
        false,
        0
    )
    local Tween = Services.TweenService:Create(Instance, TweenInfo, Properties)
    Tween:Play()
    return Tween
end

-- Easing functions for spring-like animation
function Animation:Spring(Instance, Properties, Speed)
    Speed = Speed or 0.15
    local StartTime = tick()
    local StartValues = {}

    for Property, TargetValue in pairs(Properties) do
        StartValues[Property] = Instance[Property]
    end

    local Connection
    Connection = Services.RunService.RenderStepped:Connect(function()
        local Elapsed = tick() - StartTime
        local Alpha = 1 - math.exp(-Elapsed / Speed)

        if Alpha >= 0.995 then
            Alpha = 1
            Connection:Disconnect()
        end

        for Property, TargetValue in pairs(Properties) do
            local StartValue = StartValues[Property]
            if typeof(StartValue) == "UDim2" then
                Instance[Property] = UDim2.new(
                    StartValue.X.Scale + (TargetValue.X.Scale - StartValue.X.Scale) * Alpha,
                    StartValue.X.Offset + (TargetValue.X.Offset - StartValue.X.Offset) * Alpha,
                    StartValue.Y.Scale + (TargetValue.Y.Scale - StartValue.Y.Scale) * Alpha,
                    StartValue.Y.Offset + (TargetValue.Y.Offset - StartValue.Y.Offset) * Alpha
                )
            elseif typeof(StartValue) == "number" then
                Instance[Property] = StartValue + (TargetValue - StartValue) * Alpha
            elseif typeof(StartValue) == "Color3" then
                Instance[Property] = StartValue:Lerp(TargetValue, Alpha)
            else
                Instance[Property] = TargetValue
            end
        end
    end)
    return Connection
end

