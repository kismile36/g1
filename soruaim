local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = workspace.CurrentCamera

local Effect = require(ReplicatedStorage:WaitForChild("Effect"))
local Util = require(ReplicatedStorage:WaitForChild("Util"))


local OldIndex
OldIndex = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and self == Mouse and (key == "Hit" or key == "Target") and _G.FakeSoruTarget then
        if key == "Hit" then
            return _G.FakeSoruTarget
        end
    end
    return OldIndex(self, key)
end)

local function GetClosestPlayerInScreen()
    local closestPlayer = nil
    local shortestDistance = 200 
    
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local myPos = Character.HumanoidRootPart.Position
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local targetHum = char:FindFirstChild("Humanoid")
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                
                if targetHum and targetRoot and targetHum.Health > 0 then
                    local _, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                    
                    if onScreen then
                        local distance = (targetRoot.Position - myPos).Magnitude
                        if distance <= 200 and distance < shortestDistance then
                            shortestDistance = distance
                            closestPlayer = char
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer
end


local function ExecuteSmartSoru()
    local targetChar = GetClosestPlayerInScreen()
    local Character = LocalPlayer.Character
    
    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and Character then
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if not HumanoidRootPart then return end
        
        local targetPos = (targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)).Position
        _G.FakeSoruTarget = CFrame.new(targetPos)
        
        local success = pcall(function()
            local cas = game:GetService("ContextActionService")
            cas:CallFunction("BoundActionSoru", Enum.UserInputState.Begin, Instance.new("InputObject"))
            task.wait(0.05)
            cas:CallFunction("BoundActionSoru", Enum.UserInputState.End, Instance.new("InputObject"))
        end)

  
        if not success then
            local startCFrame = HumanoidRootPart.CFrame
            local finalCFrame = (startCFrame - startCFrame.Position) + targetPos + Vector3.new(0, HumanoidRootPart.Size.Y * 1.5, 0)
            local randomId = math.random(1, 999999999)
            
            
            ReplicatedStorage.Remotes.CommE:FireServer(
                "Soru", 
                startCFrame, 
                finalCFrame, 
                workspace:GetServerTimeNow(), 
                randomId
            )
            
      
            local isEvolvedHuman = false
            if LocalPlayer.Data.Race.Value == "Human" and LocalPlayer.Data.Race:FindFirstChild("Evolved") then
                isEvolvedHuman = LocalPlayer.Data.Race:FindFirstChild("A") and LocalPlayer.Data.Race.A.Value >= 1 and LocalPlayer.Data.Race.A.Value or false
            end
            local isDracoEvolved = (LocalPlayer.Data.Race.Value == "Draco" and LocalPlayer.Data.Race:FindFirstChild("Evolved"))
            
            local SharedSoru = Effect.new("Shared.Soru")
            
           
            if isEvolvedHuman then
                Effect.new("RaceAwakenings.Human"):play({ Root = HumanoidRootPart, originPos = startCFrame, goalPos = finalCFrame, level = isEvolvedHuman })
            elseif isDracoEvolved then
                Effect.new("DracoRace.Step"):play({ ID = 1, CFrame = startCFrame, Character = Character, player = LocalPlayer })
            else
                SharedSoru:play({ Mode = 1, CFrame = startCFrame, Character = Character, player = LocalPlayer })
            end
            
        
            HumanoidRootPart.CFrame = finalCFrame
            
           
            local animSpeed = math.clamp((HumanoidRootPart.Velocity * Vector3.new(1, 0, 1)).Magnitude / 16, 1.1, 3.3)
            
            if isDracoEvolved then
                local dracoAnim = Util.Anims:Get(Character, "FlashStepDraco")
                if dracoAnim then dracoAnim:Play(0, nil, animSpeed) end
                Effect.new("DracoRace.Step"):play({ ID = 2, CFrame = HumanoidRootPart.CFrame, Character = Character, player = LocalPlayer })
            elseif not isEvolvedHuman then
                local regularAnim = Util.Anims:Get(Character, "FlashStepRegular")
                if regularAnim then regularAnim:Play(0, nil, animSpeed) end
                SharedSoru:play({ Mode = 2, CFrame = finalCFrame, Character = Character })
            end
            
        
            ReplicatedStorage.Events.PlaySkillCooldownAnimation:Fire("BoundActionSoru", "none", isEvolvedHuman and 10 or 15)
        end
        
        task.delay(0.2, function()
            _G.FakeSoruTarget = nil
        end)
    else
        _G.FakeSoruTarget = nil
    end
end


local isHooked = false

local function SetupSoruInterceptor()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 5)
    if not PlayerGui then return end
    
    local ContextButtonFrame = PlayerGui:WaitForChild("MobileContextButtons", 5)
        and PlayerGui.MobileContextButtons:WaitForChild("ContextButtonFrame", 5)
        
    if not ContextButtonFrame then return end
    
    local SoruButton = ContextButtonFrame:WaitForChild("BoundActionSoru", 5)
    if not SoruButton then return end

    if _G.SoruConnection then
        _G.SoruConnection:Disconnect()
    end

    if not isHooked then
        isHooked = true
    end

    _G.SoruConnection = SoruButton:GetAttributeChangedSignal("Selected"):Connect(function()
        local isSelected = SoruButton:GetAttribute("Selected")
        if isSelected == false then
            local canTrigger = false
            
            pcall(function()
                local mobileButtons = PlayerGui:FindFirstChild("MobileContextButtons")
                local btnFrame = mobileButtons and mobileButtons:FindFirstChild("ContextButtonFrame")
                local boundSoru = btnFrame and btnFrame:FindFirstChild("BoundActionSoru")
                local button = boundSoru and boundSoru:FindFirstChild("Button")
                local cdObj = button and button:FindFirstChild("Cooldown")
                
                if cdObj then
                    local perc = cdObj:GetAttribute("Percentage")
                    if type(perc) == "number" and perc <= 0 then
                        canTrigger = true
                    end
                end
            end)
            
            if canTrigger then
                ExecuteSmartSoru()
            end
        end
    end)
end


task.spawn(function()
    while task.wait(2) do
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            SetupSoruInterceptor()
        end
    end
end)
