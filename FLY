local function clampSpeed(v)
	v = math.floor(tonumber(v) or speed)
	if v < minSpeed then v = minSpeed end
	if v > maxSpeed then v = maxSpeed end
	return v
end

local function setSpeed(v)
	speed = clampSpeed(v)
	s.Text = tostring(speed)
end

local function changeSpeed(delta)
	setSpeed(speed + delta)
end

-- // PHYSICS
local function clearPhysics()
	if attachment then
		attachment:Destroy()
		attachment = nil
	end
	lv = nil
	ao = nil
end

local function lockPose()
	if not humanoid or not character then return end

	animateScript = character:FindFirstChild("Animate")
	if animateScript then
		animateScript.Disabled = true
	end

	lockedTracks = {}
	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		track:AdjustSpeed(0)
		table.insert(lockedTracks, track)
	end
end

local function unlockPose()
	for _, track in ipairs(lockedTracks) do
		if track then
			pcall(function()
				track:AdjustSpeed(1)
			end)
		end
	end
	lockedTracks = {}

	if animateScript then
		animateScript.Disabled = false
		animateScript = nil
	elseif character then
		local a = character:FindFirstChild("Animate")
		if a then a.Disabled = false end
	end
end

local function keepPoseLocked()
	if not flying or not humanoid then return end
	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		if track.Speed ~= 0 then
			track:AdjustSpeed(0)
		end
	end
end

local function setupPhysics()
	character = player.Character or player.CharacterAdded:Wait()
	humanoid = character:WaitForChild("Humanoid")
	root = character:WaitForChild("HumanoidRootPart")

	clearPhysics()
	if not flying then return end

	lockPose()

	humanoid.PlatformStand = true
	attachment = Instance.new("Attachment")
	attachment.Parent = root

	lv = Instance.new("LinearVelocity")
	lv.MaxForce = 9e9
	lv.VectorVelocity = Vector3.zero
	lv.Attachment0 = attachment
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.Parent = attachment

	ao = Instance.new("AlignOrientation")
	ao.MaxTorque = 9e9
	ao.Responsiveness = 200
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = attachment
	ao.Parent = attachment
end

local function stopFly()
	flying = false
	o.Text = "开始"
	if humanoid then
		humanoid.PlatformStand = false
	end
	clearPhysics()
	unlockPose()
end

local function startFly()
	flying = true
	o.Text = "停止"
	setupPhysics()
end

local function toggleFly()
	if flying then
		stopFly()
	else
		startFly()
	end
end

player.CharacterAdded:Connect(function()
