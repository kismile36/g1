-- ===== 严格速度控制核心 =====
local conn = RunService.RenderStepped:Connect(function()
	if not flying or not root or not lv or not ao or not workspace.CurrentCamera then
		return
	end

	keepPoseLocked()

	local cam = workspace.CurrentCamera
	local moveVector = Controls:GetMoveVector()
	local direction = Vector3.zero

	-- 计算移动方向，严格单位化
	if moveVector.Magnitude > 0 then
		local rawDirection = (cam.CFrame.LookVector * -moveVector.Z) + (cam.CFrame.RightVector * moveVector.X)
		if rawDirection.Magnitude > 0.001 then
			direction = rawDirection.Unit
		end
	end

	-- 严格设置速度：精确到小数点后3位，并强制物理速度同步
	if direction.Magnitude > 0 then
		local exactSpeed = math.floor(speed * 1000) / 1000
		local targetVelocity = direction * exactSpeed
		lv.VectorVelocity = targetVelocity
		-- 每帧强制物理速度完全等于目标值，无视任何外部物理干扰
		root.AssemblyLinearVelocity = targetVelocity
	else
		lv.VectorVelocity = Vector3.zero
		root.AssemblyLinearVelocity = Vector3.zero
	end

	ao.CFrame = cam.CFrame
end)
-- ===== 严格速度控制结束 =====

