local holdConn = nil
local function startHold(delta)
	if holdConn then holdConn:Disconnect() end
	changeSpeed(delta)
	holdConn = RunService.Heartbeat:Connect(function()
		changeSpeed(delta)
	end)
end

local function stopHold()
	if holdConn then
		holdConn:Disconnect()
		holdConn = nil
	end
end

