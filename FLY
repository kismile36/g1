local upDown=nil



local function moveY(value)


	if upDown then
		upDown:Disconnect()
	end



	upDown=
	R.Heartbeat:Connect(function()


		if fm.r then

			fm.r.CFrame=
			fm.r.CFrame
			*
			CFrame.new(
				0,
				value,
				0
			)


		end


	end)


end




local function stopY()


	if upDown then

		upDown:Disconnect()

		upDown=nil

	end


end




