--==============================
-- 飞行核心
--==============================

local F={}
F.__index=F



function F.new()

	local self=setmetatable({},F)

	self.v=1
	self.f=false
	self.n=false

	self.c={}
	self.w={}
	self.p={}

	self.l=nil
	self.m=nil

	self.ch=nil
	self.h=nil
	self.r=nil

	self.i=nil

	self.pl=LP

	self.nc=nil
	self.nl=nil


	self:e()

	return self

end



function F:e()

	self:uC()


	table.insert(
		self.c,
		self.pl.CharacterAdded:Connect(function()

			task.wait(.2)

			self:uC()

			if self.f then
				self:sF()
			end

		end)
	)

end



function F:uC()

	self.ch=self.pl.Character

	if self.ch then

		self.h=self.ch:FindFirstChildOfClass("Humanoid")

		self.r=self.ch:FindFirstChild("HumanoidRootPart")

	end

end



--==============================
-- 水中冲突修复核心
--==============================

function F:FixWater()

	if not self.h then return end


	self.h:SetStateEnabled(
		Enum.HumanoidStateType.Swimming,
		false
	)


	self.h:SetStateEnabled(
		Enum.HumanoidStateType.Physics,
		true
	)


	local state=self.h:GetState()


	if state==Enum.HumanoidStateType.Swimming then
		
		self.h:ChangeState(
			Enum.HumanoidStateType.Physics
		)

	end


end
--==============================
-- 清理
--==============================

function F:sA()

	if self.l then
		self.l:Disconnect()
		self.l=nil
	end


	for _,v in ipairs(self.w) do

		if v then
			v:Disconnect()
		end

	end

	self.w={}

end



function F:clP()

	for _,v in ipairs(self.p) do

		if v and v.Parent then
			v:Destroy()
		end

	end

	self.p={}

end



--==============================
-- 动画
--==============================

function F:pI()

	if not self.h then return end


	local anim=Instance.new("Animation")

	anim.AnimationId="rbxassetid://507766666"


	self.i=self.h:LoadAnimation(anim)


	if self.i then

		self.i.Looped=true
		self.i.Priority=Enum.AnimationPriority.Idle
		self.i:Play()

	end

end



function F:sI()

	if self.i then

		self.i:Stop()
		self.i=nil

	end

end




--==============================
-- 穿墙
--==============================


function F:aN()

	if not self.ch then return end


	for _,v in ipairs(self.ch:GetDescendants()) do

		if v:IsA("BasePart") then

			v.CanCollide=false

		end

	end


	self.nl=R.Heartbeat:Connect(function()

		if not self.n then return end


		if self.ch then

			for _,v in ipairs(self.ch:GetDescendants()) do

				if v:IsA("BasePart") then
					v.CanCollide=false
				end

			end

		end


	end)

end



function F:rN()

	if not self.ch then return end


	if self.nl then
		self.nl:Disconnect()
		self.nl=nil
	end


	for _,v in ipairs(self.ch:GetDescendants()) do

		if v:IsA("BasePart") then

			v.CanCollide=true

		end

	end

end





--==============================
-- 禁止游戏水泳状态
--==============================


function F:dH()

	if not self.h then return end


	local states={

		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Flying,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.GettingUp,
		Enum.HumanoidStateType.Jumping,
		Enum.HumanoidStateType.Landed,
		Enum.HumanoidStateType.PlatformStanding,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Running,
		Enum.HumanoidStateType.RunningNoPhysics,
		Enum.HumanoidStateType.Seated,

	}


	for _,v in ipairs(states) do

		self.h:SetStateEnabled(v,false)

	end



	--关键修复
	self.h:SetStateEnabled(
		Enum.HumanoidStateType.Swimming,
		false
	)


	self.h:SetStateEnabled(
		Enum.HumanoidStateType.Physics,
		true
	)


	self.h:ChangeState(
		Enum.HumanoidStateType.Physics
	)


end




function F:eH()

	if not self.h then return end


	for _,v in ipairs(Enum.HumanoidStateType:GetEnumItems()) do

		self.h:SetStateEnabled(v,true)

	end


	self.h:ChangeState(
		Enum.HumanoidStateType.Running
	)

end





--==============================
-- 飞行速度
--==============================


function F:cV(c,sp)

	local cam=workspace.CurrentCamera

	if not cam then
		return Vector3.zero
	end


	local cf=cam.CFrame


	local move=

	(cf.LookVector*(c.f+c.b))


	+

	(cf.RightVector*(c.r+c.l))


	return move*sp


end




function F:gI()

	local i={
		f=0,
		b=0,
		l=0,
		r=0
	}


	if U:IsKeyDown(Enum.KeyCode.W) then
		i.f=1
	end


	if U:IsKeyDown(Enum.KeyCode.S) then
		i.b=-1
	end


	if U:IsKeyDown(Enum.KeyCode.A) then
		i.l=-1
	end


	if U:IsKeyDown(Enum.KeyCode.D) then
		i.r=1
	end


	return i

end





--==============================
-- R15 飞行
--==============================


function F:sR15()


	local root=self.r

	if not root then return end



	self:clP()



	local gyro=Instance.new("BodyGyro")

	gyro.Name="FlightGyro"

	gyro.P=90000

	gyro.MaxTorque=
	Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)

	gyro.CFrame=root.CFrame

	gyro.Parent=root



	local vel=Instance.new("BodyVelocity")

	vel.Name="FlightVelocity"

	vel.MaxForce=
	Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)


	vel.P=100000

	vel.Velocity=Vector3.zero

	vel.Parent=root



	table.insert(self.p,gyro)
	table.insert(self.p,vel)



	self.l=R.RenderStepped:Connect(function()

		if not self.f then
			return
		end


		--防水系统抢控制
		self:FixWater()


		local input=self:gI()


		-- 无惯性移动
		if input.f+input.b~=0 
		or input.l+input.r~=0 then
			
			vel.Velocity=
			self:cV(
				input,
				self.v*10
			)

		else
			
			--松开立即停止
			vel.Velocity=Vector3.zero
			
		end



		gyro.CFrame=
		workspace.CurrentCamera.CFrame


	end)


end




--==============================
-- R6
--==============================


function F:sR6()

	self:sR15()

end
--==============================
-- 开启飞行
--==============================

function F:sF()

	self:uC()


	if not self.ch or not self.h or not self.r then
		return
	end


	self.f=true

	o.Text="停止"


	--关闭游戏动画影响

	local anim=self.ch:FindFirstChild("Animate")

	if anim then
		anim.Disabled=true
	end



	--禁止水系统抢控制

	self:dH()



	--暂停人物动画

	for _,v in ipairs(self.h:GetPlayingAnimationTracks()) do

		v:AdjustSpeed(0)

	end



	self:pI()



	if self.h.RigType==Enum.HumanoidRigType.R6 then

		self:sR6()

	else

		self:sR15()

	end


end





--==============================
-- 停止飞行
--==============================


function F:eF()

	self.f=false


	o.Text="开始"



	self:sA()

	self:clP()

	self:sI()


	self:eH()



	local anim=self.ch and self.ch:FindFirstChild("Animate")


	if anim then

		anim.Disabled=false

	end



	if self.h then

		self.h.PlatformStand=false

	end


end




function F:tF()

	if self.f then

		self:eF()

	else

		self:sF()

	end

end





--==============================
-- 穿墙切换
--==============================


function F:tN()

	self.n=not self.n


	if self.n then

		nc.Text="正常模式"

		self:aN()


	else

		nc.Text="穿墙模式"

		self:rN()

	end


end




--==============================
-- 速度设置
--==============================


function F:sS()

	local num=tonumber(s.Text)


	if num then


		if num<1 then
			num=1
		end


		if num>150 then
			num=150
		end


		self.v=num

		s.Text=tostring(num)


	else

		s.Text=tostring(self.v)

	end

end





function F:iS()

	if self.v<150 then

		self.v=self.v+1

		s.Text=tostring(self.v)

	end

end




function F:dS()

	if self.v>1 then

		self.v=self.v-1

		s.Text=tostring(self.v)

	end

end





