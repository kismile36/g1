                local targetTree = _G.HuntingTarget
                local treePos = targetTree:IsA("Model") and targetTree.PrimaryPart and targetTree.PrimaryPart.CFrame or targetTree.CFrame
                
                if treePos then
                    local dist = (character.HumanoidRootPart.Position - treePos.Position).Magnitude
                    if dist <= 5 then
                        fireSkullGuitar(treePos.Position)
                    end
                end
            end)
        end
    end
end)

--====================================================
-- 自动装备武器逻辑
--====================================================
local function GetWeapon()
    if not LocalPlayer then return nil end
    
    local targetType = _G.WeaponType or "Melee"

    -- 检查背包
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.ToolTip == targetType then
                return item
            end
        end
    end
    
    -- 检查角色（是否已经装备）
    local character = LocalPlayer.Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item.ToolTip == targetType then
                return item
            end
        end
    end
    
    return nil
end


task.spawn(function()
    while task.wait(0.1) do
        -- 【重要修复】仅在打树时 (HuntingType == "Tree") 暂停自动装备主要武器，
        -- 防止把刚拿出来的 Skull Guitar 给顶替掉；如果是在打鸟王 (HuntingType == "Bird") 或刷怪，则正常装备
        if _G.AutoEquipWeapon and _G.HuntingType ~= "Tree" then
            pcall(function()
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChild("Humanoid")
                
                if not character or not humanoid or humanoid.Health <= 0 then
                    return
                end
                
                local weapon = GetWeapon()
                
                if weapon and weapon.Parent ~= character then
                    humanoid:EquipTool(weapon)
                end
            end)
        end
    end
end)

