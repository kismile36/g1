local function forceNoclip()
    local character = LocalPlayer.Character
    if not character then return end
    
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end


local ActiveTween = nil

local function SetCollide()
    local character = LocalPlayer.Character
    if not character then return end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.CanTouch   = true
            v.CanQuery   = true
        end
    end
end

local function SetNoCollide()
    local character = LocalPlayer.Character
    if not character then return end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.CanTouch   = true
            v.CanQuery   = true
        end
    end
end

local function topos(Pos)
    if not LocalPlayer or not LocalPlayer.Character then return end
    
    local HRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
    if not HRP or not Humanoid then return end

    HRP.AssemblyLinearVelocity  = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    local Distance = (Pos.Position - HRP.Position).Magnitude
    
    local Speed = 350
    if Distance < 150 then
        Speed = 600
    elseif Distance < 250 then
        Speed = 450
    elseif Distance < 500 then
        Speed = 400
    elseif Distance < 750 then
        Speed = 300
    end

    if ActiveTween then ActiveTween:Cancel() end

    ActiveTween = game:GetService("TweenService"):Create(
        HRP,
        TweenInfo.new(Distance / Speed, Enum.EasingStyle.Linear),
        {CFrame = Pos}
    )

    local isActive = true
    task.spawn(function()
        while isActive and ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing do
            SetNoCollide()
            task.wait(0.001)
        end
    end)

    ActiveTween:Play()

    ActiveTween.Completed:Connect(function()
        isActive = false
        if Humanoid then
            SetCollide()
            Humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
    
    task.delay(0.05, function()
        if Humanoid then
            Humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

local function StopTween()
    if ActiveTween then
        ActiveTween:Cancel()
        ActiveTween = nil
    end
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local bodyClip = LocalPlayer.Character.HumanoidRootPart:FindFirstChild("BodyClip")
        if bodyClip then bodyClip:Destroy() end
    end
end


