-- 自动鸟王鹰眼与召唤检测循环
--====================================================
task.spawn(function()
    while task.wait(0.5) do
        -- 把自动鸟王和自动刷怪绑定在同一个开关 _G.AutoBird 上
        if _G.AutoBird then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local myRoot = character.HumanoidRootPart
                
                -- 首先看鸟王(Tyrant of the Skies)是不是已经存在了（被召唤出来了）
                local birdAlive = false
                local targetBirdMob = nil
                local enemiesFolder = workspace:FindFirstChild("Enemies")
                
                if enemiesFolder then
                    for _, mob in ipairs(enemiesFolder:GetChildren()) do
                        if mob.Name == "Tyrant of the Skies" then
                            local hum = mob:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                birdAlive = true
                                targetBirdMob = mob
                                break
                            end
                        end
                    end
                end
                
                -- 当鹰眼变红（检测通过）或者鸟王存活时，我们进入“专心狩猎鸟王”的状态
                -- 注意：如果鸟王存活，就不要去检测鹰眼了，防止一边打鸟王一边跑去打树
                local eagleEyeActive = false
                if not birdAlive then
                    eagleEyeActive = checkEagleEye() -- Check eagle eye status
                end
                
                if birdAlive or eagleEyeActive then
                    if not _G.isHuntingBird then
                        -- 记录当前状态，并强行关闭日常刷怪和聚怪
                        _G.isHuntingBird = true
                        
                        -- 【优先级：打树和打鸟王高于刷怪】
                        -- 如果担心 return 拦截失败，我们双重保险：直接断开日常刷怪的连接
                        if FarmConnection then
                            FarmConnection:Disconnect()
                            FarmConnection = nil
                        end
                    end
                else
                    -- 既没有鸟王，鹰眼也没亮（鸟王死了，或者刚开始挂机还没触发）
                    if _G.isHuntingBird then
                        -- 狩猎结束，恢复原来的状态
                        _G.isHuntingBird = false
                    end
                end
                
                -- 更新全局目标，供高频循环使用
                if _G.isHuntingBird then
                    if birdAlive and targetBirdMob then
                        _G.HuntingTarget = targetBirdMob
                        _G.HuntingType = "Bird"
                    elseif eagleEyeActive then
                        _G.HuntingTarget = getNearestTree()
                        _G.HuntingType = "Tree"
                    end
                else
                    _G.HuntingTarget = nil
                    _G.HuntingType = nil
                end
            end
        else
            if _G.isHuntingBird then
                _G.isHuntingBird = false
                _G.HuntingTarget = nil
                _G.HuntingType = nil
            end
        end
    end
end)

--====================================================
-- 高频追踪循环 (用于紧密吸附鸟王或树)
--====================================================
local HuntingConnection = nil
task.spawn(function()
    while task.wait(1) do
        if _G.AutoBird then
            if not HuntingConnection then
                HuntingConnection = RunService.Stepped:Connect(function()
                    if not _G.AutoBird or not _G.isHuntingBird or not _G.HuntingTarget then return end
                    
                    local character = LocalPlayer.Character
                    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                    local myRoot = character.HumanoidRootPart
                    
                    forceNoclip()
                    
                    if _G.HuntingType == "Bird" then
                        local targetRoot = _G.HuntingTarget:FindFirstChild("HumanoidRootPart")
                        if targetRoot then
                            -- 鸟王的绝对Y轴上方25个单位
                            local targetCFrame = CFrame.new(targetRoot.Position + Vector3.new(0, 25, 0))
                            local dist = (myRoot.Position - targetCFrame.Position).Magnitude
                            if dist > 5 then
                                topos(targetCFrame)
                            else
                                StopTween()
                                myRoot.CFrame = targetCFrame
                            end
                        end
                    elseif _G.HuntingType == "Tree" then
                        local targetTree = _G.HuntingTarget
                        local treePos = targetTree:IsA("Model") and targetTree.PrimaryPart and targetTree.PrimaryPart.CFrame or targetTree.CFrame
                        if treePos then
                            local dist = (myRoot.Position - treePos.Position).Magnitude
                            if dist > 5 then
                                topos(treePos)
                            else
                                StopTween()
                                myRoot.CFrame = treePos
                            end
                        end
                    end
                end)
            end
        else
            if HuntingConnection then
                HuntingConnection:Disconnect()
                HuntingConnection = nil
            end
        end
    end
end)

--====================================================
-- 打树专属射击线程 (避免在 Stepped 中触发导致掉帧和线程爆炸)
--====================================================
task.spawn(function()
    while task.wait(0.2) do
