local function GetFarmTarget()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = character.HumanoidRootPart.Position

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    -- 如果 _G.AutoBird 开启，优先无视 FarmLocation 去寻找鸟王
    if _G.AutoBird then
        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            if mob.Name == "Tyrant of the Skies" then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChild("Humanoid")
                -- 检查存活并且血量不能是 0 (有时候假怪血量会显示异常)
                if root and hum and hum.Health > 0 and mob.PrimaryPart ~= nil then
                    return mob
                end
            end
        end
    end

    -- 否则按左边/右边寻找普通怪
    local targetMobs = _G.FarmLocation == "左边" and LeftMobs or RightMobs
    local nearestMob = nil
    local minDistance = math.huge

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if targetMobs[mob.Name] then
            local root = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            -- 检查存活，并加上 PrimaryPart 检查以防假怪
            if root and hum and hum.Health > 0 and mob.PrimaryPart ~= nil then
                local dist = (root.Position - myPos).Magnitude
                -- 如果怪离得太远(超过 5000)，通常是没渲染好或者是假坐标，过滤掉
                if dist < minDistance and dist < 5000 then
                    minDistance = dist
                    nearestMob = mob
                end
            end
        end
    end
    
    return nearestMob
end


