    while task.wait(0.5) do
        if _G.AutoBird then
            if not FarmConnection then
                FarmConnection = RunService.Heartbeat:Connect(function()
                    if not _G.AutoBird then
                        if FarmConnection then
                            FarmConnection:Disconnect()
                            FarmConnection = nil
                        end
                        return
                    end

                    -- 刷怪逻辑限频到约 10Hz，避免每帧扫怪/建 Tween
                    local now = tick()
                    if now - LastFarmTick < 0.1 then
                        return
                    end
                    LastFarmTick = now

                    local character = LocalPlayer.Character
                    if not character then return end
                    local myRoot = character:FindFirstChild("HumanoidRootPart")
                    if not myRoot then return end

                    local spawnCFrame = GetCurrentWaitPos()
                    local distToSpawn = (myRoot.Position - spawnCFrame.Position).Magnitude

                    if not hasReachedSpawn then
                        forceNoclip()
                        if distToSpawn > 5 then
                            topos(spawnCFrame)
                            return
                        else
                            StopTween()
                            myRoot.CFrame = spawnCFrame
                            hasReachedSpawn = true
                        end
                    end

                    if _G.isHuntingBird then
                        BringMob = false
                        BringCount = 0
                        return
                    end

                    local targetMob = GetFarmTarget()
                    if targetMob then
                        local targetRoot = targetMob:FindFirstChild("HumanoidRootPart")
                        if not targetRoot then
                            return
                        end

                        forceNoclip()
                        ResetFarmWaitIndex()

                        BringMob = true
                        MonFarm = targetMob.Name
                        FarmPos = targetRoot.CFrame
                        targetRoot.CanCollide = false
                        local head = targetMob:FindFirstChild("Head")
                        if head then
                            head.CanCollide = false
                        end
                        local hum = targetMob:FindFirstChild("Humanoid")
                        if hum and hum.WalkSpeed ~= 0 then
                            hum.WalkSpeed = 0
                        end

                        local targetCFrame = CFrame.new(targetRoot.Position + UP25)
                        local dist = (myRoot.Position - targetCFrame.Position).Magnitude
                        if dist > 5 then
                            topos(targetCFrame)
                        else
                            StopTween()
                            myRoot.CFrame = targetCFrame
                        end
                    else
                        BringMob = false
                        BringCount = 0
                        forceNoclip()
                        local waitPos = AdvanceWaitPos(myRoot)
                        local dist = (myRoot.Position - waitPos.Position).Magnitude
                        if dist > 5 then
                            topos(waitPos)
                        else
                            StopTween()
                            myRoot.CFrame = waitPos
                        end
                    end
                end)
            end
        else
            if FarmConnection then
                FarmConnection:Disconnect()
                FarmConnection = nil
                hasReachedSpawn = false
                ResetFarmWaitIndex()
            end
            BringMob = false
            BringCount = 0
            CachedFarmTarget = nil
            if not _G.AutoBird then
                StopTween()
            end
        end
    end
end)

