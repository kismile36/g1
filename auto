local function handleAbility(abilityType)
    task.spawn(function()
        while true do
            if _G["Auto" .. abilityType] then
                if abilityType == "V4" then
                    -- 【修复】死亡后，角色和背包会重新生成，所以必须同时检查 Backpack 和 Character 里的 Awakening
                    local Awakening = nil
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Awakening") then
                        Awakening = LocalPlayer.Character:FindFirstChild("Awakening")
                    elseif LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Awakening") then
                        Awakening = LocalPlayer.Backpack:FindFirstChild("Awakening")
                    end
                    
