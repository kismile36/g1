local function startAutoHakiLoop()
    task.spawn(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
        local commF = remotes and remotes:WaitForChild("CommF_", 5)
        
        while true do
            task.wait(2) 
            if _G.AutoHaki and commF then
                local Character = LocalPlayer.Character
                if Character and not Character:FindFirstChild("HasBuso") then
                    pcall(function()
                        commF:InvokeServer("Buso")
                    end)
                end
            end
        end
    end)
end

local function handleAbility(abilityType)
    task.spawn(function()
        while true do
            if _G["Auto" .. abilityType] then
                if abilityType == "V4" then
                    -- 【修复】死亡后，角色和背包会重新生成，所以必须同时检查 Backpack 和 Character 里的 Awakening
                    local Awakening = nil
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Awakening") then
                        Awakening = LocalPlayer.Character:FindFirstChild("Awakening")
                    elseif LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Awakening") then
                        Awakening = LocalPlayer.Backpack:FindFirstChild("Awakening")
                    end
                    
                    if Awakening and Awakening:FindFirstChild("RemoteFunction") then
                        pcall(function() Awakening.RemoteFunction:InvokeServer(true) end)
                    end
                elseif abilityType == "V3" then
                    -- 【修复】虽然 Remotes 在 ReplicatedStorage 里不会随死亡销毁，但这里加个防错处理
                    local CommE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")
                    if CommE then
                        pcall(function() CommE:FireServer("ActivateAbility") end)
                    end
                end
            end
            task.wait(1)
        end
    end)
end

