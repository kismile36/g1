--====================================================
-- 自动装备武器逻辑
--====================================================
local function GetWeapon()
    if not LocalPlayer then return nil end

    local targetType = _G.WeaponType or "Melee"
    local character = LocalPlayer.Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item.ToolTip == targetType then
                return item
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.ToolTip == targetType then
                return item
            end
        end
    end

    return nil
end


task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoEquipWeapon and _G.HuntingType ~= "Tree" then
            pcall(function()
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChild("Humanoid")
                if not character or not humanoid or humanoid.Health <= 0 then
                    return
                end

                local weapon = GetWeapon()
                if weapon and weapon.Parent ~= character then
                    humanoid:EquipTool(weapon)
                end
            end)
        end
    end
end)

--====================================================
-- FPS 优化逻辑 (删除粒子/特效)
--====================================================
task.spawn(function()
    while task.wait(5) do
        if _G.OptimizeFPS then
            pcall(function()
                local effects = workspace:FindFirstChild("Effects")
                local targets = effects and {effects} or {workspace}
                for t = 1, #targets do
                    local root = targets[t]
                    local descendants = root:GetDescendants()
                    for i = 1, #descendants do
                        local obj = descendants[i]
                        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                            obj:Destroy()
                        end
                    end
                end
            end)
        end
    end
end)

