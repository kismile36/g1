local lastPrintTime = 0
local function checkEagleEye() 
    local islandModel = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("TikiOutpost") and workspace.Map.TikiOutpost:FindFirstChild("IslandModel")
    
    -- 每隔 3 秒才打印一次，防止刷屏导致游戏卡顿
    local shouldPrint = false
    if tick() - lastPrintTime > 3 then
        shouldPrint = true
        lastPrintTime = tick()
    end

    if not islandModel then 
        if shouldPrint then print("[调试-鹰眼] 错误: 找不到 IslandModel 路径") end
        return false 
    end
    
    local targetEyes = { 
        Eye1 = false, 
        Eye2 = false, 
        Eye3 = false, 
        Eye4 = false 
    }
    
    local foundAnyEye = false
    local debugStrs = {}
    
    -- 【重要修复】之前用 GetChildren() 只能找下一级，但眼睛在 IslandChunks.E 下面，必须用 GetDescendants() 深度查找
    for _, v in ipairs(islandModel:GetDescendants()) do 
        if string.match(v.Name, "^Eye%d$") and targetEyes[v.Name] ~= nil then 
            foundAnyEye = true
            local t = tonumber(v.Transparency)
            if t == 0 then 
                targetEyes[v.Name] = true 
            end 
            
            if shouldPrint then
                local colorStr = "N/A"
                if v:IsA("BasePart") then
                    colorStr = tostring(math.floor(v.Color.R*255)) .. "," .. tostring(math.floor(v.Color.G*255)) .. "," .. tostring(math.floor(v.Color.B*255))
                end
                table.insert(debugStrs, string.format("%s(T:%s,C:%s)", v.Name, tostring(t), colorStr))
            end
        end 
    end 
    
    if shouldPrint then
        if not foundAnyEye then
            print("[调试-鹰眼] 警告: 在 IslandModel 下没找到任何名为 Eye1~4 的部件！请检查是不是不在这个岛上")
        else
            print("[调试-鹰眼] 找到眼睛状态: " .. table.concat(debugStrs, " | "))
        end
    end
    
    for eyeName, found in pairs(targetEyes) do 
        if not found then 
            if shouldPrint and foundAnyEye then
                print("[调试-鹰眼] 检测未通过，还有眼睛未亮起: " .. eyeName)
            end
            return false 
        end 
    end 
    
    if shouldPrint then
        print("[调试-鹰眼] 成功！4个鹰眼已全部激活 (Transparency == 0)!")
    end
    return true 
end

local lastTreePrintTime = 0
local function getNearestTree()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = character.HumanoidRootPart.Position

    local shouldPrint = false
    if tick() - lastTreePrintTime > 3 then
        shouldPrint = true
        lastTreePrintTime = tick()
    end

    -- 深度查找 EagleBossArena，防止中间某一层加载慢或名称有细微差别
    local islandModel = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("TikiOutpost") and workspace.Map.TikiOutpost:FindFirstChild("IslandModel")
    if not islandModel then 
        if shouldPrint then print("[调试-找树] 错误: 找不到 IslandModel") end
        return nil 
    end

    local arena = nil
    for _, v in ipairs(islandModel:GetDescendants()) do
        if v.Name == "EagleBossArena" then
            arena = v
            break
        end
    end

    if not arena then 
        if shouldPrint then print("[调试-找树] 错误: 找不到 EagleBossArena (使用 GetDescendants 也没找到)") end
        return nil 
    end

    local nearestTree = nil
    local minDistance = math.huge
    local treeCount = 0

    -- 深度查找所有叫 tree 的部件/模型
    for _, obj in ipairs(arena:GetDescendants()) do
        if string.lower(obj.Name) == "tree" then
            treeCount = treeCount + 1
            if obj:IsA("Model") and obj.PrimaryPart then
                local dist = (obj.PrimaryPart.Position - myPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearestTree = obj
                end
            elseif obj:IsA("BasePart") then
                local dist = (obj.Position - myPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearestTree = obj
                end
            end
        end
    end

    if shouldPrint then
        if nearestTree then
            print("[调试-找树] 成功！找到 " .. treeCount .. " 棵树，最近的距离: " .. math.floor(minDistance))
        else
            print("[调试-找树] 警告: EagleBossArena 里面没有叫 tree 的东西！")
        end
    end

    return nearestTree
end

local function fireSkullGuitar(targetPos)
